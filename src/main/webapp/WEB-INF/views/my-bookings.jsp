<%-- filename: my-bookings.jsp --%>
<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c"  uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>My Bookings — SkyReserve</title>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    /* Code Generated by Sidekick is for learning and experimentation purposes only. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg-deep:     #0a0a0f;
      --bg-card:     rgba(255,255,255,0.04);
      --border:      rgba(255,255,255,0.08);
      --accent:      #6c63ff;
      --accent-2:    #00d4ff;
      --accent-glow: rgba(108,99,255,0.35);
      --green:       #22c55e;
      --green-glow:  rgba(34,197,94,0.22);
      --amber:       #f59e0b;
      --danger:      #ef4444;
      --text-1:      #f0f0f8;
      --text-2:      #9898b8;
      --text-3:      #55557a;
    }

    body {
      min-height: 100vh;
      font-family: 'Open Sans', sans-serif;
      background: var(--bg-deep);
      padding: 40px 20px 64px;
      overflow-x: hidden;
    }

    /* Background orbs */
    body::before, body::after {
      content: '';
      position: fixed;
      border-radius: 50%;
      filter: blur(130px);
      z-index: 0;
      pointer-events: none;
    }
    body::before {
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(108,99,255,0.17) 0%, transparent 70%);
      top: -150px; left: -150px;
      animation: drift1 12s ease-in-out infinite alternate;
    }
    body::after {
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(0,212,255,0.11) 0%, transparent 70%);
      bottom: -100px; right: -100px;
      animation: drift2 15s ease-in-out infinite alternate;
    }
    @keyframes drift1 { from{transform:translate(0,0);} to{transform:translate(60px,40px);} }
    @keyframes drift2 { from{transform:translate(0,0);} to{transform:translate(-50px,-30px);} }

    /* Page wrapper */
    .page {
      position: relative;
      z-index: 1;
      max-width: 780px;
      margin: 0 auto;
    }

    /* ── Page hero ── */
    .page-hero {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 36px;
      animation: fadeUp 0.5s cubic-bezier(0.22,1,0.36,1) both;
    }
    .hero-left { display: flex; align-items: center; gap: 18px; }
    .hero-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 60px; height: 60px;
      border-radius: 20px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      font-size: 26px;
      box-shadow: 0 8px 32px var(--accent-glow);
      flex-shrink: 0;
    }
    .hero-text h1 {
      font-size: 26px;
      font-weight: 800;
      color: var(--text-1);
      letter-spacing: -0.5px;
    }
    .hero-text p { font-size: 13px; color: var(--text-2); margin-top: 4px; }

    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      border-radius: 12px;
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--border);
      color: var(--text-2);
      font-family: 'Open Sans', sans-serif;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.18s, border-color 0.18s, color 0.18s, transform 0.18s;
    }
    .back-btn:hover {
      background: rgba(108,99,255,0.1);
      border-color: rgba(108,99,255,0.35);
      color: var(--text-1);
      transform: translateY(-1px);
    }

    /* ── Summary chips ── */
    .summary-row {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 32px;
      animation: fadeUp 0.5s 0.08s cubic-bezier(0.22,1,0.36,1) both;
    }
    .chip {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 18px;
      border-radius: 14px;
      backdrop-filter: blur(12px);
      font-size: 13px;
      font-weight: 700;
    }
    .chip-purple {
      background: rgba(108,99,255,0.12);
      border: 1px solid rgba(108,99,255,0.28);
      color: #c4c0ff;
    }
    .chip-green {
      background: rgba(34,197,94,0.1);
      border: 1px solid rgba(34,197,94,0.25);
      color: #86efac;
    }
    .chip-cyan {
      background: rgba(0,212,255,0.08);
      border: 1px solid rgba(0,212,255,0.22);
      color: #67e8f9;
    }
    .chip-num { font-size: 18px; font-weight: 800; color: var(--text-1); }

    /* ── Booking cards ── */
    .bookings-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .booking-card {
      position: relative;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 22px;
      overflow: hidden;
      backdrop-filter: blur(20px);
      box-shadow:
        0 0 0 1px rgba(255,255,255,0.03),
        0 12px 40px rgba(0,0,0,0.35);
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s;
      animation: fadeUp 0.55s cubic-bezier(0.22,1,0.36,1) both;
    }
    .booking-card:hover {
      transform: translateY(-4px);
      border-color: rgba(108,99,255,0.28);
      box-shadow:
        0 0 0 1px rgba(108,99,255,0.15),
        0 20px 56px rgba(0,0,0,0.45),
        0 0 40px rgba(108,99,255,0.1);
    }

    /* Accent left bar */
    .booking-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; bottom: 0;
      width: 3px;
      background: linear-gradient(180deg, var(--accent), var(--accent-2));
    }

    /* Card header */
    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 24px 16px 32px;
      border-bottom: 1px solid var(--border);
      flex-wrap: wrap;
      gap: 12px;
    }
    .booking-id-wrap { display: flex; align-items: center; gap: 12px; }
    .booking-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 42px; height: 42px;
      border-radius: 13px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      font-size: 18px;
      box-shadow: 0 4px 16px var(--accent-glow);
      flex-shrink: 0;
    }
    .booking-id-text { display: flex; flex-direction: column; gap: 2px; }
    .booking-label {
      font-size: 10px;
      font-weight: 700;
      color: var(--text-3);
      text-transform: uppercase;
      letter-spacing: 0.9px;
    }
    .booking-id-num {
      font-size: 16px;
      font-weight: 800;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      letter-spacing: 0.5px;
    }

    /* Status pill */
    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 14px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.4px;
      background: rgba(34,197,94,0.1);
      border: 1px solid rgba(34,197,94,0.28);
      color: #86efac;
    }
    .status-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 6px var(--green);
      animation: blink 1.6s ease-in-out infinite;
    }
    @keyframes blink { 0%,100%{opacity:1;} 50%{opacity:0.3;} }

    /* Card body grid */
    .card-body {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
      padding: 0;
    }
    .info-cell {
      padding: 18px 24px 18px 32px;
      border-right: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .info-cell:last-child,
    .info-cell:nth-last-child(2),
    .info-cell:nth-last-child(3) { border-bottom: none; }
    .info-cell:nth-child(3n)     { border-right: none; }

    .info-label {
      font-size: 10px;
      font-weight: 700;
      color: var(--text-3);
      text-transform: uppercase;
      letter-spacing: 0.9px;
      margin-bottom: 7px;
    }
    .info-value {
      font-size: 15px;
      font-weight: 700;
      color: var(--text-1);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* Price highlight */
    .price-value {
      font-size: 20px;
      font-weight: 800;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      letter-spacing: -0.3px;
    }

    /* Seat badge */
    .seat-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 700;
      background: rgba(108,99,255,0.12);
      border: 1px solid rgba(108,99,255,0.28);
      color: #c4c0ff;
    }

    /* Card footer */
    .card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
      padding: 12px 24px 12px 32px;
      background: rgba(255,255,255,0.02);
      border-top: 1px solid var(--border);
    }
    .footer-tags { display: flex; gap: 8px; flex-wrap: wrap; }
    .tag {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
    }
    .tag-confirmed {
      background: rgba(34,197,94,0.08);
      border: 1px solid rgba(34,197,94,0.22);
      color: #86efac;
    }
    .tag-instant {
      background: rgba(0,212,255,0.08);
      border: 1px solid rgba(0,212,255,0.2);
      color: #67e8f9;
    }

    /* View tickets button */
    .btn-tickets {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 9px 18px;
      border-radius: 11px;
      background: rgba(108,99,255,0.12);
      border: 1px solid rgba(108,99,255,0.3);
      color: #c4c0ff;
      font-family: 'Open Sans', sans-serif;
      font-size: 12px;
      font-weight: 700;
      text-decoration: none;
      transition: background 0.18s, border-color 0.18s, transform 0.18s, box-shadow 0.18s;
    }
    .btn-tickets:hover {
      background: rgba(108,99,255,0.2);
      border-color: rgba(108,99,255,0.5);
      transform: translateY(-1px);
      box-shadow: 0 4px 16px var(--accent-glow);
    }

    /* ── Empty state ── */
    .empty-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 80px 20px;
      text-align: center;
      animation: fadeUp 0.5s 0.1s cubic-bezier(0.22,1,0.36,1) both;
    }
    .empty-icon  { font-size: 60px; margin-bottom: 20px; }
    .empty-wrap h3 { font-size: 22px; font-weight: 800; color: var(--text-1); }
    .empty-wrap p  {
      font-size: 14px;
      color: var(--text-2);
      margin-top: 10px;
      line-height: 1.7;
      max-width: 320px;
    }
    .btn-search {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 28px;
      padding: 14px 28px;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      color: #fff;
      font-family: 'Open Sans', sans-serif;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      box-shadow: 0 8px 28px var(--accent-glow);
      transition: transform 0.18s, filter 0.18s;
    }
    .btn-search:hover { transform: translateY(-2px); filter: brightness(1.1); }

    /* Page footer */
    .page-footer {
      text-align: center;
      margin-top: 52px;
      font-size: 11px;
      color: var(--text-3);
      letter-spacing: 0.3px;
      animation: fadeUp 0.5s 0.4s cubic-bezier(0.22,1,0.36,1) both;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 600px) {
      .card-body { grid-template-columns: 1fr 1fr; }
      .info-cell:nth-child(3n)    { border-right: 1px solid var(--border); }
      .info-cell:nth-child(2n)    { border-right: none; }
      .page-hero { flex-direction: column; align-items: flex-start; }
    }
    @media (max-width: 400px) {
      .card-body { grid-template-columns: 1fr; }
      .info-cell { border-right: none !important; }
    }
  </style>
</head>
<body>
<div class="page">

  <!-- Page hero -->
  <div class="page-hero">
    <div class="hero-left">
      <div class="hero-icon">📋</div>
      <div class="hero-text">
        <h1>My Bookings</h1>
        <p>All your flight reservations in one place</p>
      </div>
    </div>
    <a href="${pageContext.request.contextPath}/user/dashboard" class="back-btn">
      ← Back to Dashboard
    </a>
  </div>

  <c:choose>
    <c:when test="${not empty bookings}">

      <!-- Summary chips -->
      <div class="summary-row">
        <div class="chip chip-purple">
          📋 &nbsp;Total Bookings &nbsp;
          <span class="chip-num">${fn:length(bookings)}</span>
        </div>
        <div class="chip chip-green">
          ✅ &nbsp;Confirmed
        </div>
        <div class="chip chip-cyan">
          ⚡ &nbsp;Instant Booking
        </div>
      </div>

      <!-- Booking cards -->
      <div class="bookings-list">
        <c:forEach var="booking" items="${bookings}" varStatus="loop">
          <c:set var="delay" value="${loop.index * 0.08}"/>

          <div class="booking-card" style="animation-delay:${delay}s">

            <!-- Card header -->
            <div class="card-header">
              <div class="booking-id-wrap">
                <div class="booking-icon">🎫</div>
                <div class="booking-id-text">
                  <span class="booking-label">Booking ID</span>
                  <span class="booking-id-num">#BK-${booking.bookingId}</span>
                </div>
              </div>
              <span class="status-pill">
                <span class="status-dot"></span>
                Confirmed
              </span>
            </div>

            <!-- Info grid -->
            <div class="card-body">

              <div class="info-cell">
                <div class="info-label">Journey Date</div>
                <div class="info-value">📅 ${booking.journeyDate}</div>
              </div>

              <div class="info-cell">
                <div class="info-label">Seats Booked</div>
                <div class="info-value">
                  <span class="seat-badge">💺 ${booking.seats}</span>
                </div>
              </div>

              <div class="info-cell">
                <div class="info-label">Total Price</div>
                <div class="info-value">
                  <span class="price-value">&#8377;${booking.totalPrice}</span>
                </div>
              </div>

            </div>

            <!-- Card footer -->
            <div class="card-footer">
              <div class="footer-tags">
                <span class="tag tag-confirmed">✔ Booking Confirmed</span>
                <span class="tag tag-instant">⚡ Instant</span>
              </div>
              <a href="${pageContext.request.contextPath}/user/tickets?bookingId=${booking.bookingId}"
   class="btn-tickets">
    🎟 View Tickets →
</a>
                          </div>

          </div>
        </c:forEach>
      </div>

    </c:when>
    <c:otherwise>

      <!-- Empty state -->
      <div class="empty-wrap">
        <div class="empty-icon">📋</div>
        <h3>No Bookings Yet</h3>
        <p>You haven't made any reservations.<br/>
           Search for flights and book your first trip!</p>
        <a href="${pageContext.request.contextPath}/" class="btn-search">
          ✈️ &nbsp;Search Flights
        </a>
      </div>

    </c:otherwise>
  </c:choose>

  <div class="page-footer">SkyReserve &nbsp;•&nbsp; Every Journey Matters ✈️ &nbsp;•&nbsp; Safe Travels 🛡️</div>

</div>
</body>
</html>
