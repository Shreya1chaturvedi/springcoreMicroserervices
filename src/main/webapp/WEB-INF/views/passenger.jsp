<%-- filename: add-passenger.jsp --%>
<%@ page contentType="text/html;charset=UTF-8" %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Add Passenger — SkyReserve</title>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    /* Code Generated by Sidekick is for learning and experimentation purposes only. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg-deep:     #0a0a0f;
      --bg-card:     rgba(255,255,255,0.04);
      --border:      rgba(255,255,255,0.08);
      --accent:      #6c63ff;
      --accent-2:    #00d4ff;
      --accent-glow: rgba(108,99,255,0.35);
      --green:       #22c55e;
      --green-glow:  rgba(34,197,94,0.22);
      --text-1:      #f0f0f8;
      --text-2:      #9898b8;
      --text-3:      #55557a;
      --input-bg:    rgba(255,255,255,0.05);
      --input-focus: rgba(108,99,255,0.15);
    }

    body {
      min-height: 100vh;
      font-family: 'Open Sans', sans-serif;
      background: var(--bg-deep);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px 16px;
      overflow-x: hidden;
    }

    body::before, body::after {
      content: '';
      position: fixed;
      border-radius: 50%;
      filter: blur(130px);
      z-index: 0;
      pointer-events: none;
    }
    body::before {
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(108,99,255,0.18) 0%, transparent 70%);
      top: -150px; left: -150px;
      animation: drift1 12s ease-in-out infinite alternate;
    }
    body::after {
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(0,212,255,0.12) 0%, transparent 70%);
      bottom: -100px; right: -100px;
      animation: drift2 14s ease-in-out infinite alternate;
    }
    @keyframes drift1 { from{transform:translate(0,0);} to{transform:translate(60px,40px);} }
    @keyframes drift2 { from{transform:translate(0,0);} to{transform:translate(-50px,-30px);} }

    /* Card */
    .card {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 500px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 48px 40px;
      backdrop-filter: blur(24px);
      box-shadow:
        0 0 0 1px rgba(255,255,255,0.04),
        0 32px 64px rgba(0,0,0,0.5),
        0 0 80px var(--accent-glow);
      animation: fadeUp 0.6s cubic-bezier(0.22,1,0.36,1) both;
    }

    /* ── Progress tracker ── */
    .progress-wrap { margin-bottom: 36px; }
    .progress-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 10px;
    }
    .progress-label {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-2);
      text-transform: uppercase;
      letter-spacing: 0.9px;
    }
    .progress-counter {
      font-size: 12px;
      font-weight: 800;
      color: #a89fff;
    }
    .step-dots {
      display: flex;
      gap: 6px;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }
    .step-dot {
      flex: 1;
      min-width: 20px;
      max-width: 40px;
      height: 6px;
      border-radius: 99px;
      background: var(--border);
      transition: background 0.3s ease;
    }
    .step-dot.done {
      background: var(--green);
      box-shadow: 0 0 8px var(--green-glow);
    }
    .step-dot.active {
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      box-shadow: 0 0 10px var(--accent-glow);
      animation: pulseDot 1.5s ease-in-out infinite;
    }
    @keyframes pulseDot { 0%,100%{opacity:1;} 50%{opacity:0.6;} }

    .progress-bar-wrap {
      width: 100%;
      height: 4px;
      background: var(--border);
      border-radius: 99px;
      overflow: hidden;
    }
    .progress-bar-fill {
      height: 100%;
      border-radius: 99px;
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      box-shadow: 0 0 10px var(--accent-glow);
      transition: width 0.5s cubic-bezier(0.22,1,0.36,1);
    }

    /* ── Header ── */
    .card-header {
      text-align: center;
      margin-bottom: 32px;
    }
    .header-icon {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 68px; height: 68px;
      border-radius: 22px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      font-size: 28px;
      margin-bottom: 16px;
      box-shadow: 0 8px 32px var(--accent-glow);
    }
    .passenger-num-badge {
      position: absolute;
      top: -8px; right: -8px;
      width: 24px; height: 24px;
      border-radius: 50%;
      background: var(--green);
      border: 2px solid var(--bg-deep);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 800;
      color: #fff;
      box-shadow: 0 0 8px var(--green-glow);
    }
    .card-header h1 {
      font-size: 24px;
      font-weight: 800;
      color: var(--text-1);
      letter-spacing: -0.5px;
    }
    .card-header p { font-size: 13px; color: var(--text-2); margin-top: 6px; line-height: 1.6; }

    /* Info banner */
    .info-banner {
      display: flex;
      align-items: center;
      gap: 10px;
      background: rgba(108,99,255,0.08);
      border: 1px solid rgba(108,99,255,0.22);
      border-radius: 12px;
      padding: 12px 16px;
      font-size: 12px;
      color: #c4c0ff;
      font-weight: 600;
      margin-bottom: 28px;
      line-height: 1.5;
    }

    /* Divider */
    .divider {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 22px;
    }
    .divider-line  { flex: 1; height: 1px; background: var(--border); }
    .divider-label { font-size: 11px; color: var(--text-2); letter-spacing: 1px; text-transform: uppercase; white-space: nowrap; }

    /* Form groups */
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 20px;
    }
    label {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-2);
      letter-spacing: 0.8px;
      text-transform: uppercase;
    }
    .input-wrap {
      position: relative;
      display: flex;
      align-items: center;
    }
    .input-icon {
      position: absolute;
      left: 14px;
      font-size: 15px;
      pointer-events: none;
      color: var(--text-2);
      transition: color 0.2s;
      z-index: 1;
    }
    .input-wrap:focus-within .input-icon { color: var(--accent); }

    input[type="text"],
    input[type="number"] {
      width: 100%;
      padding: 14px 14px 14px 42px;
      background: var(--input-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      color: var(--text-1);
      font-family: 'Open Sans', sans-serif;
      font-size: 14px;
      font-weight: 600;
      outline: none;
      transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
    }
    input::placeholder { color: #55557a; font-weight: 400; }
    input:focus {
      border-color: var(--accent);
      background: var(--input-focus);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }

    /* ── Gender selector cards ── */
    .gender-label {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-2);
      letter-spacing: 0.8px;
      text-transform: uppercase;
      display: block;
      margin-bottom: 10px;
    }
    .gender-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-bottom: 28px;
    }
    .gender-card { position: relative; cursor: pointer; }
    .gender-card input[type="radio"] {
      position: absolute;
      opacity: 0;
      width: 0; height: 0;
    }
    .gender-tile {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 16px 10px;
      border-radius: 16px;
      border: 2px solid var(--border);
      background: rgba(255,255,255,0.03);
      cursor: pointer;
      transition: border-color 0.2s, background 0.2s,
                  box-shadow 0.2s, transform 0.2s;
      user-select: none;
    }
    .gender-tile:hover {
      border-color: rgba(108,99,255,0.35);
      background: rgba(108,99,255,0.06);
      transform: translateY(-2px);
    }
    .gender-card input:checked ~ .gender-tile {
      border-color: var(--accent);
      background: rgba(108,99,255,0.12);
      box-shadow: 0 0 0 3px var(--accent-glow),
                  0 8px 24px rgba(108,99,255,0.15);
      transform: translateY(-2px);
    }
    .gender-emoji {
      font-size: 26px;
      transition: transform 0.2s;
    }
    .gender-card input:checked ~ .gender-tile .gender-emoji {
      transform: scale(1.15);
    }
    .gender-name {
      font-size: 12px;
      font-weight: 700;
      color: var(--text-1);
    }
    .gender-check {
      position: absolute;
      top: 8px; right: 8px;
      width: 18px; height: 18px;
      border-radius: 50%;
      background: var(--border);
      border: 2px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 9px;
      color: transparent;
      transition: background 0.2s, border-color 0.2s, color 0.2s;
    }
    .gender-card input:checked ~ .gender-tile .gender-check {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
      box-shadow: 0 0 8px var(--accent-glow);
    }

    /* Submit button */
    .btn-submit {
      width: 100%;
      padding: 15px;
      background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 100%);
      border: none;
      border-radius: 14px;
      color: #fff;
      font-family: 'Open Sans', sans-serif;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow: 0 8px 32px var(--accent-glow);
      transition: transform 0.15s, box-shadow 0.15s, filter 0.15s;
    }
    .btn-submit:hover {
      transform: translateY(-2px);
      filter: brightness(1.1);
      box-shadow: 0 14px 40px var(--accent-glow);
    }
    .btn-submit:active { transform: translateY(0); }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(40px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 480px) {
      .card { padding: 32px 20px; }
    }
  </style>
</head>
<body>

<div class="card">

  <!-- Progress tracker -->
  <div class="progress-wrap">
    <div class="progress-header">
      <span class="progress-label">✈️ &nbsp;Passenger Details</span>
      <span class="progress-counter">${currentPassenger} of ${totalPassengers}</span>
    </div>
    <div class="step-dots"  id="stepDots"></div>
    <div class="progress-bar-wrap">
      <div class="progress-bar-fill" id="progressFill"></div>
    </div>
  </div>

  <!-- Header -->
  <div class="card-header">
    <div class="header-icon">
      👤
      <span class="passenger-num-badge">${currentPassenger}</span>
    </div>
    <h1>Passenger ${currentPassenger}</h1>
    <p>Enter details for passenger ${currentPassenger} of ${totalPassengers}</p>
  </div>

  <!-- Info banner -->
  <div class="info-banner">
    ℹ️ &nbsp;Please enter details exactly as on the passenger's government-issued ID.
  </div>

  <form action="${pageContext.request.contextPath}/passenger" method="post">

    <div class="divider">
      <div class="divider-line"></div>
      <span class="divider-label">Personal Info</span>
      <div class="divider-line"></div>
    </div>

    <!-- Name -->
    <div class="form-group">
      <label for="passengerName">Full Name</label>
      <div class="input-wrap">
        <span class="input-icon">👤</span>
        <input type="text" id="passengerName" name="passengerName"
               placeholder="e.g. Rahul Sharma" required/>
      </div>
    </div>

    <!-- Age -->
    <div class="form-group">
      <label for="age">Age</label>
      <div class="input-wrap">
        <span class="input-icon">🎂</span>
        <input type="number" id="age" name="age"
               min="1" max="120"
               placeholder="Enter age" required/>
      </div>
    </div>

    <!-- Gender cards -->
    <span class="gender-label">Gender</span>
    <div class="gender-grid">

      <label class="gender-card">
        <input type="radio" name="gender" value="Male" required/>
        <div class="gender-tile">
          <span class="gender-check">✓</span>
          <span class="gender-emoji">♂️</span>
          <span class="gender-name">Male</span>
        </div>
      </label>

      <label class="gender-card">
        <input type="radio" name="gender" value="Female"/>
        <div class="gender-tile">
          <span class="gender-check">✓</span>
          <span class="gender-emoji">♀️</span>
          <span class="gender-name">Female</span>
        </div>
      </label>

      <label class="gender-card">
        <input type="radio" name="gender" value="Other"/>
        <div class="gender-tile">
          <span class="gender-check">✓</span>
          <span class="gender-emoji">⚧️</span>
          <span class="gender-name">Other</span>
        </div>
      </label>

    </div>

    <!-- Submit -->
    <button type="submit" class="btn-submit">
      <span>👤</span>
      <span>Add Passenger &amp; Continue →</span>
    </button>

  </form>
</div>

<script>
  /* Code Generated by Sidekick is for learning and experimentation purposes only. */
  (function () {
    const current = parseInt('${currentPassenger}') || 1;
    const total   = parseInt('${totalPassengers}')  || 1;

    /* Progress bar */
    document.getElementById('progressFill').style.width =
      Math.round((current / total) * 100) + '%';

    /* Step dots */
    const container = document.getElementById('stepDots');
    for (let i = 1; i <= total; i++) {
      const dot = document.createElement('div');
      dot.className = 'step-dot' +
        (i < current   ? ' done'   : '') +
        (i === current ? ' active' : '');
      container.appendChild(dot);
    }
  })();
</script>

</body>
</html>
