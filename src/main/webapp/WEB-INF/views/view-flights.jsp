<%-- filename: view-flights.jsp --%>
<%@ page contentType="text/html;charset=UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core"%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>My Bookings — SkyReserve</title>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    /* Code Generated by Sidekick is for learning and experimentation purposes only. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg-deep:     #0a0a0f;
      --bg-card:     rgba(255,255,255,0.04);
      --bg-row:      rgba(255,255,255,0.02);
      --bg-row-alt:  rgba(108,99,255,0.04);
      --border:      rgba(255,255,255,0.08);
      --accent:      #6c63ff;
      --accent-2:    #00d4ff;
      --accent-glow: rgba(108,99,255,0.35);
      --green:       #22c55e;
      --green-glow:  rgba(34,197,94,0.2);
      --amber:       #f59e0b;
      --amber-glow:  rgba(245,158,11,0.2);
      --danger:      #ef4444;
      --text-1:      #f0f0f8;
      --text-2:      #9898b8;
      --text-3:      #55557a;
    }

    body {
      min-height: 100vh;
      font-family: 'Open Sans', sans-serif;
      background: var(--bg-deep);
      padding: 40px 20px 60px;
      overflow-x: hidden;
    }

    /* Background orbs */
    body::before, body::after {
      content: '';
      position: fixed;
      border-radius: 50%;
      filter: blur(130px);
      z-index: 0;
      pointer-events: none;
    }
    body::before {
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(108,99,255,0.15) 0%, transparent 70%);
      top: -150px; left: -150px;
      animation: drift1 12s ease-in-out infinite alternate;
    }
    body::after {
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(0,212,255,0.10) 0%, transparent 70%);
      bottom: -100px; right: -100px;
      animation: drift2 15s ease-in-out infinite alternate;
    }
    @keyframes drift1 { from { transform: translate(0,0); } to { transform: translate(60px,40px); } }
    @keyframes drift2 { from { transform: translate(0,0); } to { transform: translate(-50px,-30px); } }

    /* Layout wrapper */
    .page {
      position: relative;
      z-index: 1;
      max-width: 960px;
      margin: 0 auto;
    }

    /* Page hero */
    .page-hero {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 40px;
      animation: fadeUp 0.5s cubic-bezier(0.22,1,0.36,1) both;
    }
    .hero-left { display: flex; align-items: center; gap: 18px; }
    .hero-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 60px; height: 60px;
      border-radius: 20px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      font-size: 26px;
      box-shadow: 0 8px 32px var(--accent-glow);
      flex-shrink: 0;
    }
    .hero-text h1 {
      font-size: 26px;
      font-weight: 800;
      color: var(--text-1);
      letter-spacing: -0.5px;
    }
    .hero-text p {
      font-size: 13px;
      color: var(--text-2);
      margin-top: 4px;
    }
    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      border-radius: 12px;
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--border);
      color: var(--text-2);
      font-family: 'Open Sans', sans-serif;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.18s, border-color 0.18s, color 0.18s, transform 0.18s;
    }
    .back-btn:hover {
      background: rgba(108,99,255,0.1);
      border-color: rgba(108,99,255,0.35);
      color: var(--text-1);
      transform: translateY(-1px);
    }

    /* Summary chips */
    .summary-row {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 36px;
      animation: fadeUp 0.5s 0.08s cubic-bezier(0.22,1,0.36,1) both;
    }
    .chip {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 18px;
      border-radius: 14px;
      backdrop-filter: blur(12px);
      font-size: 13px;
      font-weight: 700;
    }
    .chip-purple {
      background: rgba(108,99,255,0.12);
      border: 1px solid rgba(108,99,255,0.28);
      color: #c4c0ff;
    }
    .chip-green {
      background: rgba(34,197,94,0.1);
      border: 1px solid rgba(34,197,94,0.26);
      color: #86efac;
    }
    .chip-num {
      font-size: 18px;
      font-weight: 800;
      color: var(--text-1);
    }

    /* Section block */
    .section {
      margin-bottom: 40px;
      animation: fadeUp 0.5s cubic-bezier(0.22,1,0.36,1) both;
    }
    .section:nth-of-type(1) { animation-delay: 0.12s; }
    .section:nth-of-type(2) { animation-delay: 0.22s; }

    .section-header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 16px;
    }
    .section-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 38px; height: 38px;
      border-radius: 12px;
      font-size: 17px;
    }
    .icon-upcoming  { background: rgba(108,99,255,0.14); }
    .icon-completed { background: rgba(34,197,94,0.12); }

    .section-title {
      font-size: 17px;
      font-weight: 800;
      color: var(--text-1);
    }
    .section-count {
      margin-left: auto;
      font-size: 12px;
      font-weight: 700;
      padding: 3px 12px;
      border-radius: 999px;
    }
    .count-purple {
      background: rgba(108,99,255,0.14);
      border: 1px solid rgba(108,99,255,0.28);
      color: #a89fff;
    }
    .count-green {
      background: rgba(34,197,94,0.1);
      border: 1px solid rgba(34,197,94,0.25);
      color: #86efac;
    }

    /* Table card */
    .table-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 20px;
      overflow: hidden;
      backdrop-filter: blur(20px);
      box-shadow:
        0 0 0 1px rgba(255,255,255,0.03),
        0 16px 48px rgba(0,0,0,0.4);
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }
    thead tr {
      background: rgba(255,255,255,0.04);
      border-bottom: 1px solid var(--border);
    }
    th {
      padding: 14px 20px;
      text-align: left;
      font-size: 11px;
      font-weight: 700;
      color: var(--text-2);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      white-space: nowrap;
    }
    tbody tr {
      border-bottom: 1px solid var(--border);
      transition: background 0.18s;
    }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:nth-child(odd)  { background: var(--bg-row); }
    tbody tr:nth-child(even) { background: var(--bg-row-alt); }
    tbody tr:hover { background: rgba(108,99,255,0.08); }

    td {
      padding: 16px 20px;
      font-size: 13px;
      color: var(--text-1);
      font-weight: 600;
      vertical-align: middle;
    }

    /* Flight number cell */
    .flight-num {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 700;
      color: #c4c0ff;
    }
    .flight-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 6px var(--accent);
    }

    /* Route cell */
    .route-cell {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: var(--text-1);
    }
    .route-arrow {
      color: var(--text-3);
      font-size: 14px;
    }

    /* Seat badge */
    .seat-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 12px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
    }
    .seat-high {
      background: rgba(34,197,94,0.12);
      border: 1px solid rgba(34,197,94,0.28);
      color: #86efac;
    }
    .seat-mid {
      background: rgba(245,158,11,0.1);
      border: 1px solid rgba(245,158,11,0.28);
      color: #fcd34d;
    }
    .seat-low {
      background: rgba(239,68,68,0.1);
      border: 1px solid rgba(239,68,68,0.28);
      color: #fca5a5;
    }

    /* Price cell */
    .price-cell {
      font-size: 14px;
      font-weight: 800;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Status badge */
    .status-done {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 12px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      background: rgba(34,197,94,0.1);
      border: 1px solid rgba(34,197,94,0.25);
      color: #86efac;
      letter-spacing: 0.4px;
    }

    /* Empty state */
    .empty-state {
      padding: 48px 20px;
      text-align: center;
    }
    .empty-state .empty-icon { font-size: 40px; margin-bottom: 12px; }
    .empty-state p {
      font-size: 14px;
      color: var(--text-2);
      font-weight: 600;
    }
    .empty-state span {
      font-size: 12px;
      color: var(--text-3);
      display: block;
      margin-top: 4px;
    }

    /* Responsive scroll */
    .table-scroll { overflow-x: auto; }

    /* Footer */
    .page-footer {
      text-align: center;
      margin-top: 48px;
      font-size: 11px;
      color: var(--text-3);
      letter-spacing: 0.3px;
      animation: fadeUp 0.5s 0.35s cubic-bezier(0.22,1,0.36,1) both;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 600px) {
      .page-hero { flex-direction: column; align-items: flex-start; }
      th, td { padding: 12px 14px; }
    }
  </style>
</head>
<body>
<div class="page">

  <!-- Page hero -->
  <div class="page-hero">
    <div class="hero-left">
      <div class="hero-icon">🎫</div>
      <div class="hero-text">
        <h1>My Bookings</h1>
        <p>Track your upcoming and completed journeys</p>
      </div>
    </div>
    <a href="${pageContext.request.contextPath}/user/dashboard" class="back-btn">
      ← Back to Dashboard
    </a>
  </div>

  <!-- Summary chips -->
  <div class="summary-row">
    <div class="chip chip-purple">
      ✈️ &nbsp;Upcoming
      <span class="chip-num">
        <c:choose>
          <c:when test="${not empty upcoming}">${upcoming.size()}</c:when>
          <c:otherwise>0</c:otherwise>
        </c:choose>
      </span>
    </div>
    <div class="chip chip-green">
      ✅ &nbsp;Completed
      <span class="chip-num">
        <c:choose>
          <c:when test="${not empty completed}">${completed.size()}</c:when>
          <c:otherwise>0</c:otherwise>
        </c:choose>
      </span>
    </div>
  </div>

  <!-- ── Upcoming Journeys ── -->
  <div class="section">
    <div class="section-header">
      <div class="section-icon icon-upcoming">🛫</div>
      <span class="section-title">Upcoming Journeys</span>
      <span class="section-count count-purple">Active</span>
    </div>

    <div class="table-card">
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Flight</th>
              <th>Route</th>
              <th>Available Seats</th>
              <th>Price / Seat</th>
            </tr>
          </thead>
          <tbody>
            <c:choose>
              <c:when test="${not empty upcoming}">
                <c:forEach var="flight" items="${upcoming}">
                  <tr>
                    <td>
                      <span class="flight-num">
                        <span class="flight-dot"></span>
                        ${flight.flightNumber}
                      </span>
                    </td>
                    <td>
                      <span class="route-cell">
                        🛫 ${flight.source}
                        <span class="route-arrow">──›</span>
                        🛬 ${flight.destination}
                      </span>
                    </td>
                    <td>
                      <c:choose>
                        <c:when test="${flight.availableSeats > 10}">
                          <span class="seat-badge seat-high">💺 ${flight.availableSeats} seats</span>
                        </c:when>
                        <c:when test="${flight.availableSeats > 3}">
                          <span class="seat-badge seat-mid">💺 ${flight.availableSeats} seats</span>
                        </c:when>
                        <c:otherwise>
                          <span class="seat-badge seat-low">🔥 ${flight.availableSeats} left</span>
                        </c:otherwise>
                      </c:choose>
                    </td>
                    <td>
                      <span class="price-cell">&#8377;${flight.pricePerSeat}</span>
                    </td>
                  </tr>
                </c:forEach>
              </c:when>
              <c:otherwise>
                <tr>
                  <td colspan="4">
                    <div class="empty-state">
                      <div class="empty-icon">✈️</div>
                      <p>No upcoming journeys</p>
                      <span>Search flights to plan your next trip!</span>
                    </div>
                  </td>
                </tr>
              </c:otherwise>
            </c:choose>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ── Completed Journeys ── -->
  <div class="section">
    <div class="section-header">
      <div class="section-icon icon-completed">✅</div>
      <span class="section-title">Completed Journeys</span>
      <span class="section-count count-green">Done</span>
    </div>

    <div class="table-card">
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Flight</th>
              <th>Route</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <c:choose>
              <c:when test="${not empty completed}">
                <c:forEach var="flight" items="${completed}">
                  <tr>
                    <td>
                      <span class="flight-num">
                        <span class="flight-dot" style="background:#22c55e;box-shadow:0 0 6px #22c55e;"></span>
                        ${flight.flightNumber}
                      </span>
                    </td>
                    <td>
                      <span class="route-cell">
                        🛫 ${flight.source}
                        <span class="route-arrow">──›</span>
                        🛬 ${flight.destination}
                      </span>
                    </td>
                    <td>
                      <span class="status-done">✔ Completed</span>
                    </td>
                  </tr>
                </c:forEach>
              </c:when>
              <c:otherwise>
                <tr>
                  <td colspan="3">
                    <div class="empty-state">
                      <div class="empty-icon">🗺️</div>
                      <p>No completed journeys yet</p>
                      <span>Your travel history will appear here.</span>
                    </div>
                  </td>
                </tr>
              </c:otherwise>
            </c:choose>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="page-footer">SkyReserve &nbsp;•&nbsp; Your Journey, Our Priority 🛡️</div>

</div>
</body>
</html>
