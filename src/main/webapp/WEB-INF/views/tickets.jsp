<%-- filename: tickets.jsp --%>
<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c"  uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>  <%-- ✅ FIX #1: fn taglib added --%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>My Tickets — SkyReserve</title>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    /* Code Generated by Sidekick is for learning and experimentation purposes only. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg-deep:     #0a0a0f;
      --bg-card:     rgba(255,255,255,0.04);
      --border:      rgba(255,255,255,0.08);
      --accent:      #6c63ff;
      --accent-2:    #00d4ff;
      --accent-glow: rgba(108,99,255,0.35);
      --green:       #22c55e;
      --green-glow:  rgba(34,197,94,0.22);
      --amber:       #f59e0b;
      --amber-glow:  rgba(245,158,11,0.22);
      --danger:      #ef4444;
      --danger-glow: rgba(239,68,68,0.22);
      --text-1:      #f0f0f8;
      --text-2:      #9898b8;
      --text-3:      #55557a;
    }

    body {
      min-height: 100vh;
      font-family: 'Open Sans', sans-serif;
      background: var(--bg-deep);
      padding: 40px 20px 64px;
      overflow-x: hidden;
    }

    /* Background orbs */
    body::before, body::after {
      content: '';
      position: fixed;
      border-radius: 50%;
      filter: blur(130px);
      z-index: 0;
      pointer-events: none;
    }
    body::before {
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(108,99,255,0.17) 0%, transparent 70%);
      top: -150px; left: -150px;
      animation: drift1 12s ease-in-out infinite alternate;
    }
    body::after {
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(0,212,255,0.11) 0%, transparent 70%);
      bottom: -100px; right: -100px;
      animation: drift2 15s ease-in-out infinite alternate;
    }
    @keyframes drift1 { from{transform:translate(0,0);} to{transform:translate(60px,40px);} }
    @keyframes drift2 { from{transform:translate(0,0);} to{transform:translate(-50px,-30px);} }

    .page {
      position: relative;
      z-index: 1;
      max-width: 780px;
      margin: 0 auto;
    }

    /* Page hero */
    .page-hero {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 36px;
      animation: fadeUp 0.5s cubic-bezier(0.22,1,0.36,1) both;
    }
    .hero-left { display: flex; align-items: center; gap: 18px; }
    .hero-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 60px; height: 60px;
      border-radius: 20px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      font-size: 26px;
      box-shadow: 0 8px 32px var(--accent-glow);
      flex-shrink: 0;
    }
    .hero-text h1 {
      font-size: 26px;
      font-weight: 800;
      color: var(--text-1);
      letter-spacing: -0.5px;
    }
    .hero-text p { font-size: 13px; color: var(--text-2); margin-top: 4px; }

    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      border-radius: 12px;
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--border);
      color: var(--text-2);
      font-family: 'Open Sans', sans-serif;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.18s, border-color 0.18s, color 0.18s, transform 0.18s;
    }
    .back-btn:hover {
      background: rgba(108,99,255,0.1);
      border-color: rgba(108,99,255,0.35);
      color: var(--text-1);
      transform: translateY(-1px);
    }

    /* Summary chips */
    .summary-row {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 36px;
      animation: fadeUp 0.5s 0.08s cubic-bezier(0.22,1,0.36,1) both;
    }
    .chip {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 18px;
      border-radius: 14px;
      backdrop-filter: blur(12px);
      font-size: 13px;
      font-weight: 700;
    }
    .chip-purple {
      background: rgba(108,99,255,0.12);
      border: 1px solid rgba(108,99,255,0.28);
      color: #c4c0ff;
    }
    .chip-green {
      background: rgba(34,197,94,0.1);
      border: 1px solid rgba(34,197,94,0.25);
      color: #86efac;
    }
    .chip-amber {
      background: rgba(245,158,11,0.1);
      border: 1px solid rgba(245,158,11,0.25);
      color: #fcd34d;
    }
    .chip-num { font-size: 18px; font-weight: 800; color: var(--text-1); }

    /* Boarding pass */
    .ticket-list {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    .boarding-pass {
      position: relative;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 24px;
      overflow: hidden;
      backdrop-filter: blur(20px);
      box-shadow:
        0 0 0 1px rgba(255,255,255,0.03),
        0 16px 48px rgba(0,0,0,0.4);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      animation: fadeUp 0.55s cubic-bezier(0.22,1,0.36,1) both;
    }
    .boarding-pass:hover {
      transform: translateY(-4px);
      box-shadow:
        0 0 0 1px rgba(108,99,255,0.2),
        0 24px 56px rgba(0,0,0,0.5),
        0 0 48px rgba(108,99,255,0.12);
    }

    /* Status top bar */
    .boarding-pass::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
    }
    .boarding-pass.confirmed::before {
      background: linear-gradient(90deg, var(--green), #86efac);
    }
    .boarding-pass.cancelled::before {
      background: linear-gradient(90deg, var(--danger), #fca5a5);
    }
    .boarding-pass.pending::before {
      background: linear-gradient(90deg, var(--amber), #fcd34d);
    }

    /* Header strip */
    .bp-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 28px 16px;
      border-bottom: 1px solid var(--border);
      flex-wrap: wrap;
      gap: 12px;
    }
    .bp-airline { display: flex; align-items: center; gap: 12px; }
    .bp-plane-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 42px; height: 42px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      font-size: 19px;
      box-shadow: 0 4px 16px var(--accent-glow);
    }
    .bp-flight-label {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-2);
      letter-spacing: 0.8px;
      text-transform: uppercase;
    }
    .bp-flight-num {
      font-size: 17px;
      font-weight: 800;
      color: var(--text-1);
      letter-spacing: -0.3px;
      margin-top: 1px;
    }

    /* Status badge */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.4px;
      text-transform: capitalize;
    }
    .status-dot { width: 7px; height: 7px; border-radius: 50%; }
    .badge-confirmed {
      background: rgba(34,197,94,0.12);
      border: 1px solid rgba(34,197,94,0.3);
      color: #86efac;
    }
    .badge-confirmed .status-dot {
      background: var(--green);
      box-shadow: 0 0 6px var(--green);
      animation: blink 1.6s ease-in-out infinite;
    }
    .badge-cancelled {
      background: rgba(239,68,68,0.1);
      border: 1px solid rgba(239,68,68,0.28);
      color: #fca5a5;
    }
    .badge-cancelled .status-dot { background: var(--danger); }
    .badge-pending {
      background: rgba(245,158,11,0.1);
      border: 1px solid rgba(245,158,11,0.28);
      color: #fcd34d;
    }
    .badge-pending .status-dot {
      background: var(--amber);
      animation: blink 1.2s ease-in-out infinite;
    }
    .badge-default {
      background: rgba(108,99,255,0.12);
      border: 1px solid rgba(108,99,255,0.28);
      color: #c4c0ff;
    }
    .badge-default .status-dot { background: var(--accent); }
    @keyframes blink { 0%,100%{opacity:1;} 50%{opacity:0.3;} }

    /* Tear line */
    .tear-line {
      position: relative;
      height: 1px;
      background: var(--border);
      margin: 0 28px;
      overflow: visible;
    }
    .tear-line::before,
    .tear-line::after {
      content: '';
      position: absolute;
      top: 50%;
      width: 20px; height: 20px;
      border-radius: 50%;
      background: var(--bg-deep);
      border: 1px solid var(--border);
      transform: translateY(-50%);
    }
    .tear-line::before { left: -38px; }
    .tear-line::after  { right: -38px; }

    /* Body grid */
    .bp-body {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    }
    .bp-field {
      padding: 18px 28px;
      border-right: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .bp-field:nth-child(3n)      { border-right: none; }
    .bp-field:last-child,
    .bp-field:nth-last-child(2),
    .bp-field:nth-last-child(3)  { border-bottom: none; }
    .bp-field-label {
      font-size: 10px;
      font-weight: 700;
      color: var(--text-3);
      text-transform: uppercase;
      letter-spacing: 0.9px;
      margin-bottom: 6px;
    }
    .bp-field-value {
      font-size: 14px;
      font-weight: 700;
      color: var(--text-1);
    }
    .pnr-value {
      font-size: 15px;
      font-weight: 800;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      letter-spacing: 1px;
    }
    .seat-value {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      font-weight: 800;
      color: #c4c0ff;
    }

    /* Barcode footer */
    .bp-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 28px;
      background: rgba(255,255,255,0.02);
      border-top: 1px solid var(--border);
      gap: 12px;
      flex-wrap: wrap;
    }
    .barcode {
      display: flex;
      align-items: flex-end;
      gap: 2px;
      height: 28px;
    }
    .barcode span {
      display: block;
      width: 3px;
      background: var(--text-3);
      border-radius: 1px;
      opacity: 0.6;
    }
    .bp-footer-label {
      font-size: 10px;
      color: var(--text-3);
      letter-spacing: 0.8px;
      text-transform: uppercase;
    }
    .skyreserve-mark {
      font-size: 12px;
      font-weight: 800;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      letter-spacing: 0.5px;
    }

    /* Empty state */
    .empty-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 80px 20px;
      text-align: center;
      animation: fadeUp 0.5s 0.1s cubic-bezier(0.22,1,0.36,1) both;
    }
    .empty-icon  { font-size: 56px; margin-bottom: 20px; }
    .empty-wrap h3 { font-size: 20px; font-weight: 800; color: var(--text-1); }
    .empty-wrap p  { font-size: 14px; color: var(--text-2); margin-top: 8px; }
    .empty-cta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 24px;
      padding: 13px 28px;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      color: #fff;
      font-family: 'Open Sans', sans-serif;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      box-shadow: 0 8px 28px var(--accent-glow);
      transition: transform 0.18s, filter 0.18s;
    }
    .empty-cta:hover { transform: translateY(-2px); filter: brightness(1.1); }

    .page-footer {
      text-align: center;
      margin-top: 48px;
      font-size: 11px;
      color: var(--text-3);
      letter-spacing: 0.3px;
      animation: fadeUp 0.5s 0.4s cubic-bezier(0.22,1,0.36,1) both;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 560px) {
      .bp-body { grid-template-columns: 1fr 1fr; }
      .bp-field:nth-child(3n) { border-right: 1px solid var(--border); }
      .bp-field:nth-child(2n) { border-right: none; }
      .page-hero { flex-direction: column; align-items: flex-start; }
    }
    @media (max-width: 380px) {
      .bp-body { grid-template-columns: 1fr; }
      .bp-field { border-right: none !important; }
    }
  </style>
</head>
<body>
<div class="page">

  <!-- Page hero -->
  <div class="page-hero">
    <div class="hero-left">
      <div class="hero-icon">🎟️</div>
      <div class="hero-text">
        <h1>My Tickets</h1>
        <p>Your boarding passes &amp; travel records</p>
      </div>
    </div>
    <a href="${pageContext.request.contextPath}/user/dashboard" class="back-btn">
      ← Back to Dashboard
    </a>
  </div>

  <c:choose>
    <c:when test="${not empty tickets}">

      <!-- Summary chips — ✅ FIX #2: fn:length() replaces tickets.size() -->
      <div class="summary-row">
        <div class="chip chip-purple">
          🎟️ &nbsp;Total &nbsp;
          <span class="chip-num">${fn:length(tickets)}</span>
        </div>
        <div class="chip chip-green">✅ &nbsp;Confirmed</div>
        <div class="chip chip-amber">⏳ &nbsp;Pending</div>
      </div>

      <!-- Ticket cards -->
      <div class="ticket-list">
        <c:forEach var="ticket" items="${tickets}" varStatus="loop">

          <%-- ✅ FIX #3: pre-calculate delay with c:set --%>
          <c:set var="delay" value="${loop.index * 0.08}" />

          <%-- Determine CSS class from status --%>
          <c:set var="statusClass" value="default"/>
          <c:if test="${fn:toLowerCase(ticket.status) == 'confirmed'}">
            <c:set var="statusClass" value="confirmed"/>
          </c:if>
          <c:if test="${fn:toLowerCase(ticket.status) == 'cancelled'}">
            <c:set var="statusClass" value="cancelled"/>
          </c:if>
          <c:if test="${fn:toLowerCase(ticket.status) == 'pending'}">
            <c:set var="statusClass" value="pending"/>
          </c:if>

          <div class="boarding-pass ${statusClass}"
               style="animation-delay: ${delay}s">

            <!-- Header strip -->
            <div class="bp-header">
              <div class="bp-airline">
                <div class="bp-plane-icon">✈️</div>
                <div>
                  <div class="bp-flight-label">Boarding Pass</div>
                  <div class="bp-flight-num">SkyReserve Air</div>
                </div>
              </div>

              <%-- Status badge --%>
              <c:choose>
                <c:when test="${fn:toLowerCase(ticket.status) == 'confirmed'}">
                  <span class="status-badge badge-confirmed">
                    <span class="status-dot"></span>${ticket.status}
                  </span>
                </c:when>
                <c:when test="${fn:toLowerCase(ticket.status) == 'cancelled'}">
                  <span class="status-badge badge-cancelled">
                    <span class="status-dot"></span>${ticket.status}
                  </span>
                </c:when>
                <c:when test="${fn:toLowerCase(ticket.status) == 'pending'}">
                  <span class="status-badge badge-pending">
                    <span class="status-dot"></span>${ticket.status}
                  </span>
                </c:when>
                <c:otherwise>
                  <span class="status-badge badge-default">
                    <span class="status-dot"></span>${ticket.status}
                  </span>
                </c:otherwise>
              </c:choose>
            </div>

            <!-- Tear line -->
            <div class="tear-line"></div>

            <!-- Data grid -->
            <div class="bp-body">

              <div class="bp-field">
                <div class="bp-field-label">PNR Number</div>
                <div class="bp-field-value pnr-value">${ticket.pnrNo}</div>
              </div>

              <div class="bp-field">
                <div class="bp-field-label">Passenger</div>
                <div class="bp-field-value">👤 ${ticket.passengerName}</div>
              </div>

              <div class="bp-field">
                <div class="bp-field-label">Journey Date</div>
                <div class="bp-field-value">📅 ${ticket.journeyDate}</div>
              </div>

              <div class="bp-field">
                <div class="bp-field-label">Age</div>
                <div class="bp-field-value">${ticket.age} yrs</div>
              </div>

              <div class="bp-field">
                <div class="bp-field-label">Gender</div>
                <c:choose>
                  <c:when test="${fn:toLowerCase(ticket.gender) == 'male'}">
                    <div class="bp-field-value">♂ ${ticket.gender}</div>
                  </c:when>
                  <c:when test="${fn:toLowerCase(ticket.gender) == 'female'}">
                    <div class="bp-field-value">♀ ${ticket.gender}</div>
                  </c:when>
                  <c:otherwise>
                    <div class="bp-field-value">⚧ ${ticket.gender}</div>
                  </c:otherwise>
                </c:choose>
              </div>

              <div class="bp-field">
                <div class="bp-field-label">Seat Number</div>
                <div class="bp-field-value">
                  <span class="seat-value">💺 ${ticket.seatNo}</span>
                </div>
              </div>

            </div>

            <!-- Barcode footer -->
            <div class="bp-footer">
              <div>
                <div class="bp-footer-label">Booking Reference</div>
                <div style="font-size:13px;font-weight:700;color:var(--text-2);margin-top:3px;">
                  #SKY-${ticket.pnrNo}
                </div>
              </div>
              <div class="barcode" aria-hidden="true">
                <c:forEach begin="1" end="28" varStatus="b">
                  <c:set var="barH" value="${b.index % 3 == 0 ? '28' : b.index % 2 == 0 ? '18' : '22'}"/>
                  <c:set var="barO" value="${b.index % 4 == 0 ? '0.3' : '0.6'}"/>
                  <span style="height:${barH}px; opacity:${barO};"></span>
                </c:forEach>
              </div>
              <div class="skyreserve-mark">SkyReserve ✈️</div>
            </div>

          </div>
        </c:forEach>
      </div>

    </c:when>
    <c:otherwise>

      <!-- Empty state -->
      <div class="empty-wrap">
        <div class="empty-icon">🎟️</div>
        <h3>No Tickets Found</h3>
        <p>You haven't booked any flights yet.<br/>Start your journey today!</p>
        <a href="${pageContext.request.contextPath}/" class="empty-cta">
          ✈️ &nbsp;Search Flights
        </a>
      </div>

    </c:otherwise>
  </c:choose>

  <div class="page-footer">SkyReserve &nbsp;•&nbsp; Safe Travels &amp; Happy Landings 🛡️</div>

</div>
</body>
</html>
