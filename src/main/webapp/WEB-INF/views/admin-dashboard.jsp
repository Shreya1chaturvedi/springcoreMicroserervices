<%-- filename: admin-dashboard.jsp --%>
<%@ page contentType="text/html;charset=UTF-8" %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin Dashboard</title>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    /* Code Generated by Sidekick is for learning and experimentation purposes only. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg-deep:      #0a0a0f;
      --bg-card:      rgba(255,255,255,0.04);
      --border:       rgba(255,255,255,0.08);
      --accent:       #6c63ff;
      --accent-2:     #00d4ff;
      --accent-glow:  rgba(108,99,255,0.35);
      --danger:       #ef4444;
      --danger-glow:  rgba(239,68,68,0.25);
      --green:        #22c55e;
      --green-glow:   rgba(34,197,94,0.25);
      --text-1:       #f0f0f8;
      --text-2:       #9898b8;
    }

    body {
      min-height: 100vh;
      font-family: 'Open Sans', sans-serif;
      background: var(--bg-deep);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 32px 16px;
      overflow-x: hidden;
    }

    /* Background orbs */
    body::before, body::after {
      content: '';
      position: fixed;
      border-radius: 50%;
      filter: blur(130px);
      z-index: 0;
      pointer-events: none;
    }
    body::before {
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(108,99,255,0.18) 0%, transparent 70%);
      top: -150px; left: -150px;
      animation: drift1 12s ease-in-out infinite alternate;
    }
    body::after {
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(0,212,255,0.12) 0%, transparent 70%);
      bottom: -100px; right: -100px;
      animation: drift2 14s ease-in-out infinite alternate;
    }
    @keyframes drift1 { from { transform: translate(0,0); } to { transform: translate(60px,40px); } }
    @keyframes drift2 { from { transform: translate(0,0); } to { transform: translate(-50px,-30px); } }

    /* Main card */
    .dashboard {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 520px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 48px 40px;
      backdrop-filter: blur(24px);
      box-shadow:
        0 0 0 1px rgba(255,255,255,0.04),
        0 32px 64px rgba(0,0,0,0.5),
        0 0 80px var(--accent-glow);
      animation: fadeUp 0.6s cubic-bezier(0.22,1,0.36,1) both;
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(40px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Header */
    .dash-header {
      text-align: center;
      margin-bottom: 40px;
    }
    .dash-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 68px; height: 68px;
      border-radius: 22px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      margin-bottom: 16px;
      font-size: 30px;
      box-shadow: 0 8px 32px var(--accent-glow);
    }
    .dash-header h1 {
      font-size: 26px;
      font-weight: 800;
      color: var(--text-1);
      letter-spacing: -0.5px;
    }
    .dash-header p {
      font-size: 13px;
      color: var(--text-2);
      margin-top: 6px;
    }

    /* Badge */
    .admin-badge {
      display: inline-block;
      margin-top: 10px;
      padding: 4px 14px;
      border-radius: 999px;
      background: rgba(108,99,255,0.15);
      border: 1px solid rgba(108,99,255,0.3);
      font-size: 11px;
      font-weight: 700;
      color: #a89fff;
      letter-spacing: 1.2px;
      text-transform: uppercase;
    }

    /* Divider */
    .divider {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 28px;
    }
    .divider-line { flex: 1; height: 1px; background: var(--border); }
    .divider-label { font-size: 11px; color: var(--text-2); letter-spacing: 1px; text-transform: uppercase; white-space: nowrap; }

    /* Nav cards */
    .nav-grid {
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-bottom: 24px;
    }

    .nav-card {
      display: flex;
      align-items: center;
      gap: 18px;
      padding: 20px 22px;
      border-radius: 16px;
      border: 1px solid var(--border);
      background: rgba(255,255,255,0.03);
      text-decoration: none;
      cursor: pointer;
      transition: transform 0.18s ease, box-shadow 0.18s ease,
                  border-color 0.18s ease, background 0.18s ease;
      animation: fadeUp 0.6s cubic-bezier(0.22,1,0.36,1) both;
    }
    .nav-card:nth-child(1) { animation-delay: 0.1s; }
    .nav-card:nth-child(2) { animation-delay: 0.2s; }

    .nav-card:hover {
      transform: translateY(-3px) scale(1.01);
      border-color: rgba(108,99,255,0.4);
      background: rgba(108,99,255,0.08);
      box-shadow: 0 8px 32px rgba(108,99,255,0.2);
    }

    .nav-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 48px; height: 48px;
      border-radius: 14px;
      font-size: 22px;
      flex-shrink: 0;
      transition: transform 0.18s ease;
    }
    .nav-card:hover .nav-icon { transform: scale(1.1) rotate(-4deg); }

    .icon-purple { background: rgba(108,99,255,0.15); }
    .icon-cyan   { background: rgba(0,212,255,0.12); }

    .nav-text { display: flex; flex-direction: column; gap: 3px; flex: 1; }
    .nav-title {
      font-size: 15px;
      font-weight: 700;
      color: var(--text-1);
    }
    .nav-sub {
      font-size: 12px;
      color: var(--text-2);
      font-weight: 400;
    }

    .nav-arrow {
      font-size: 18px;
      color: var(--text-2);
      transition: transform 0.18s ease, color 0.18s ease;
    }
    .nav-card:hover .nav-arrow {
      transform: translateX(4px);
      color: var(--accent);
    }

    /* Logout button */
    .btn-logout {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 14px;
      border-radius: 14px;
      border: 1px solid rgba(239,68,68,0.25);
      background: rgba(239,68,68,0.07);
      color: #fca5a5;
      font-family: 'Open Sans', sans-serif;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      letter-spacing: 0.3px;
      cursor: pointer;
      transition: background 0.18s, border-color 0.18s,
                  box-shadow 0.18s, transform 0.18s;
      animation: fadeUp 0.6s 0.3s cubic-bezier(0.22,1,0.36,1) both;
    }
    .btn-logout:hover {
      background: rgba(239,68,68,0.14);
      border-color: rgba(239,68,68,0.5);
      box-shadow: 0 6px 24px var(--danger-glow);
      transform: translateY(-2px);
    }

    /* Footer */
    .dash-footer {
      text-align: center;
      margin-top: 28px;
      font-size: 11px;
      color: #55557a;
      letter-spacing: 0.3px;
    }

    @media (max-width: 480px) {
      .dashboard { padding: 32px 20px; }
      .dash-header h1 { font-size: 22px; }
    }
  </style>
</head>
<body>

<div class="dashboard">

  <!-- Header -->
  <div class="dash-header">
    <div class="dash-icon">🛩️</div>
    <h1>Admin Dashboard</h1>
    <p>Manage flights, routes and system settings</p>
    <span class="admin-badge">⚡ Admin Access</span>
  </div>

  <!-- Section label -->
  <div class="divider">
    <div class="divider-line"></div>
    <span class="divider-label">Quick Actions</span>
    <div class="divider-line"></div>
  </div>

  <!-- Navigation cards -->
  <div class="nav-grid">

    <a href="${pageContext.request.contextPath}/admin/add-flight" class="nav-card">
      <div class="nav-icon icon-purple">➕</div>
      <div class="nav-text">
        <span class="nav-title">Add New Flight</span>
        <span class="nav-sub">Schedule a new flight route</span>
      </div>
      <span class="nav-arrow">›</span>
    </a>

    <a href="${pageContext.request.contextPath}/admin/view-flights" class="nav-card">
      <div class="nav-icon icon-cyan">✈️</div>
      <div class="nav-text">
        <span class="nav-title">View Flights</span>
        <span class="nav-sub">Browse and manage all flights</span>
      </div>
      <span class="nav-arrow">›</span>
    </a>

  </div>

  <!-- Logout -->
  <a href="${pageContext.request.contextPath}/logout" class="btn-logout">
    <span>🚪</span>
    <span>Logout</span>
  </a>

  <div class="dash-footer">SkyAdmin Panel &nbsp;•&nbsp; Secured Session</div>

</div>

</body>
</html>
