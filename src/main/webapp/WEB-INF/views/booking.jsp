<%-- filename: booking.jsp  ← MUST be this name, not book-flight.jsp --%>
<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c"  uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Book Flight — SkyReserve</title>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    /* Code Generated by Sidekick is for learning and experimentation purposes only. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg-deep:     #0a0a0f;
      --bg-card:     rgba(255,255,255,0.04);
      --border:      rgba(255,255,255,0.08);
      --accent:      #6c63ff;
      --accent-2:    #00d4ff;
      --accent-glow: rgba(108,99,255,0.35);
      --green:       #22c55e;
      --green-glow:  rgba(34,197,94,0.22);
      --danger:      #ef4444;
      --text-1:      #f0f0f8;
      --text-2:      #9898b8;
      --text-3:      #55557a;
      --input-bg:    rgba(255,255,255,0.05);
      --input-focus: rgba(108,99,255,0.15);
    }

    body {
      min-height: 100vh;
      font-family: 'Open Sans', sans-serif;
      background: var(--bg-deep);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px 16px;
      overflow-x: hidden;
    }

    body::before, body::after {
      content: '';
      position: fixed;
      border-radius: 50%;
      filter: blur(130px);
      z-index: 0;
      pointer-events: none;
    }
    body::before {
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(108,99,255,0.18) 0%, transparent 70%);
      top: -150px; left: -150px;
      animation: drift1 12s ease-in-out infinite alternate;
    }
    body::after {
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(0,212,255,0.12) 0%, transparent 70%);
      bottom: -100px; right: -100px;
      animation: drift2 14s ease-in-out infinite alternate;
    }
    @keyframes drift1 { from{transform:translate(0,0);} to{transform:translate(60px,40px);} }
    @keyframes drift2 { from{transform:translate(0,0);} to{transform:translate(-50px,-30px);} }

    .page { position: relative; z-index: 1; width: 100%; max-width: 560px; }

    /* Back button */
    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 9px 18px;
      border-radius: 11px;
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--border);
      color: var(--text-2);
      font-family: 'Open Sans', sans-serif;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      margin-bottom: 20px;
      transition: background 0.18s, border-color 0.18s, color 0.18s;
      animation: fadeUp 0.5s cubic-bezier(0.22,1,0.36,1) both;
    }
    .back-btn:hover {
      background: rgba(108,99,255,0.1);
      border-color: rgba(108,99,255,0.35);
      color: var(--text-1);
    }

    /* Flight info card */
    .flight-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 20px;
      overflow: hidden;
      backdrop-filter: blur(20px);
      margin-bottom: 20px;
      box-shadow: 0 12px 40px rgba(0,0,0,0.35);
      animation: fadeUp 0.5s 0.05s cubic-bezier(0.22,1,0.36,1) both;
    }
    .flight-card::before {
      content: '';
      display: block;
      height: 2px;
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
    }
    .flight-inner {
      padding: 20px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }
    .flight-num { display: flex; align-items: center; gap: 12px; }
    .flight-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px; height: 44px;
      border-radius: 13px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      font-size: 20px;
      box-shadow: 0 4px 16px var(--accent-glow);
      flex-shrink: 0;
    }
    .flight-code { font-size: 18px; font-weight: 800; color: var(--text-1); }
    .flight-label { font-size: 11px; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.7px; margin-top: 2px; }
    .route-display { display: flex; align-items: center; gap: 12px; }
    .route-city { font-size: 15px; font-weight: 700; color: var(--text-1); }
    .route-arrow { font-size: 16px; animation: fly 2.5s ease-in-out infinite; }
    @keyframes fly { 0%,100%{transform:translateX(0);} 50%{transform:translateX(5px);} }

    /* Seat badges */
    .seat-info {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
    }
    .seats-ok   { background:rgba(34,197,94,0.1);  border:1px solid rgba(34,197,94,0.28);  color:#86efac; }
    .seats-low  { background:rgba(245,158,11,0.1); border:1px solid rgba(245,158,11,0.28); color:#fcd34d; }
    .seats-full { background:rgba(239,68,68,0.1);  border:1px solid rgba(239,68,68,0.28);  color:#fca5a5; }
    .seat-dot { width:6px; height:6px; border-radius:50%; animation:blink 1.4s ease-in-out infinite; }
    .seats-ok .seat-dot   { background:var(--green); box-shadow:0 0 6px var(--green); }
    .seats-low .seat-dot  { background:#f59e0b; }
    .seats-full .seat-dot { background:var(--danger); }
    @keyframes blink { 0%,100%{opacity:1;} 50%{opacity:0.3;} }

    /* Form card */
    .form-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 36px 32px;
      backdrop-filter: blur(24px);
      box-shadow:
        0 0 0 1px rgba(255,255,255,0.04),
        0 24px 56px rgba(0,0,0,0.45),
        0 0 60px var(--accent-glow);
      animation: fadeUp 0.6s 0.1s cubic-bezier(0.22,1,0.36,1) both;
    }
    .form-header { text-align: center; margin-bottom: 32px; }
    .form-header-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 60px; height: 60px;
      border-radius: 20px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      font-size: 26px;
      margin-bottom: 14px;
      box-shadow: 0 8px 28px var(--accent-glow);
    }
    .form-header h1 { font-size: 22px; font-weight: 800; color: var(--text-1); letter-spacing: -0.4px; }
    .form-header p  { font-size: 13px; color: var(--text-2); margin-top: 5px; }

    /* Error banner */
    .error-banner {
      display: flex;
      align-items: center;
      gap: 10px;
      background: rgba(239,68,68,0.1);
      border: 1px solid rgba(239,68,68,0.28);
      color: #fca5a5;
      border-radius: 12px;
      padding: 13px 16px;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 24px;
      animation: shake 0.4s cubic-bezier(0.36,0.07,0.19,0.97) both;
    }
    @keyframes shake {
      10%,90%     { transform:translateX(-2px); }
      20%,80%     { transform:translateX( 4px); }
      30%,50%,70% { transform:translateX(-4px); }
      40%,60%     { transform:translateX( 4px); }
    }

    /* Divider */
    .divider { display:flex; align-items:center; gap:12px; margin-bottom:22px; }
    .divider-line  { flex:1; height:1px; background:var(--border); }
    .divider-label { font-size:11px; color:var(--text-2); letter-spacing:1px; text-transform:uppercase; white-space:nowrap; }

    /* Inputs */
    .form-group { display:flex; flex-direction:column; gap:8px; margin-bottom:20px; }
    label { font-size:11px; font-weight:700; color:var(--text-2); letter-spacing:0.8px; text-transform:uppercase; }
    .input-wrap { position:relative; display:flex; align-items:center; }
    .input-icon {
      position:absolute; left:14px; font-size:15px;
      pointer-events:none; color:var(--text-2);
      transition:color 0.2s; z-index:1;
    }
    .input-wrap:focus-within .input-icon { color:var(--accent); }
    input[type="date"],
    input[type="number"] {
      width:100%;
      padding:14px 14px 14px 42px;
      background:var(--input-bg);
      border:1px solid var(--border);
      border-radius:12px;
      color:var(--text-1);
      font-family:'Open Sans',sans-serif;
      font-size:14px;
      font-weight:600;
      outline:none;
      transition:border-color 0.2s, background 0.2s, box-shadow 0.2s;
    }
    input:focus {
      border-color:var(--accent);
      background:var(--input-focus);
      box-shadow:0 0 0 3px var(--accent-glow);
    }
    input[type="date"]::-webkit-calendar-picker-indicator { filter:invert(0.6); cursor:pointer; }

    /* Passenger counter */
    .passenger-counter { display:flex; align-items:center; gap:12px; }
    .counter-btn {
      display:flex; align-items:center; justify-content:center;
      width:40px; height:40px; border-radius:10px;
      background:rgba(108,99,255,0.12);
      border:1px solid rgba(108,99,255,0.28);
      color:#c4c0ff; font-size:18px; font-weight:700;
      cursor:pointer; transition:background 0.18s, transform 0.15s;
      flex-shrink:0; line-height:1;
    }
    .counter-btn:hover { background:rgba(108,99,255,0.22); transform:scale(1.08); }
    .counter-btn:active { transform:scale(0.95); }
    #passengerDisplay { font-size:22px; font-weight:800; color:var(--text-1); min-width:32px; text-align:center; }
    .counter-label { font-size:12px; color:var(--text-2); }

    /* Price preview */
    .price-preview {
      display:flex; align-items:center; justify-content:space-between;
      padding:16px 20px;
      background:rgba(108,99,255,0.07);
      border:1px solid rgba(108,99,255,0.2);
      border-radius:14px; margin-bottom:24px;
    }
    .price-label { font-size:13px; color:var(--text-2); font-weight:600; }
    .price-total {
      font-size:22px; font-weight:800;
      background:linear-gradient(135deg,var(--accent),var(--accent-2));
      -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
    }

    /* Submit */
    .btn-submit {
      width:100%; padding:15px;
      background:linear-gradient(135deg,var(--accent) 0%,var(--accent-2) 100%);
      border:none; border-radius:14px;
      color:#fff; font-family:'Open Sans',sans-serif;
      font-size:15px; font-weight:700; cursor:pointer;
      display:flex; align-items:center; justify-content:center; gap:10px;
      box-shadow:0 8px 32px var(--accent-glow);
      transition:transform 0.15s, box-shadow 0.15s, filter 0.15s;
    }
    .btn-submit:hover { transform:translateY(-2px); filter:brightness(1.1); box-shadow:0 14px 40px var(--accent-glow); }
    .btn-submit:active { transform:translateY(0); }

    @keyframes fadeUp { from{opacity:0;transform:translateY(28px);} to{opacity:1;transform:translateY(0);} }

    @media(max-width:480px) {
      .form-card { padding:28px 18px; }
      .flight-inner { flex-direction:column; align-items:flex-start; }
    }
  </style>
</head>
<body>
<div class="page">

  <!-- Back -->
  <a href="${pageContext.request.contextPath}/" class="back-btn">← Back to Search</a>

  <!-- Flight info -->
  <div class="flight-card">
    <div class="flight-inner">
      <div class="flight-num">
        <div class="flight-icon">✈️</div>
        <div>
          <div class="flight-code">${flight.flightNumber}</div>
          <div class="flight-label">SkyReserve Air</div>
        </div>
      </div>
      <div class="route-display">
        <span class="route-city">🛫 ${flight.source}</span>
        <span class="route-arrow">✈️</span>
        <span class="route-city">🛬 ${flight.destination}</span>
      </div>
      <c:choose>
        <c:when test="${flight.availableSeats > 10}">
          <span class="seat-info seats-ok"><span class="seat-dot"></span>💺 ${flight.availableSeats} seats available</span>
        </c:when>
        <c:when test="${flight.availableSeats > 0}">
          <span class="seat-info seats-low"><span class="seat-dot"></span>💺 Only ${flight.availableSeats} left!</span>
        </c:when>
        <c:otherwise>
          <span class="seat-info seats-full"><span class="seat-dot"></span>Fully Booked</span>
        </c:otherwise>
      </c:choose>
    </div>
  </div>

  <!-- Booking form -->
  <div class="form-card">
    <div class="form-header">
      <div class="form-header-icon">🎫</div>
      <h1>Complete Booking</h1>
      <p>Select your journey date and number of passengers</p>
    </div>

    <c:if test="${not empty error}">
      <div class="error-banner"><span>⚠️</span><span>${error}</span></div>
    </c:if>

    <%-- ✅ action="/booking" matches @PostMapping("/booking") in BookingController --%>
    <form action="${pageContext.request.contextPath}/booking" method="post">

      <%-- ✅ flightId matches @RequestParam long flightId --%>
      <input type="hidden" name="flightId"    value="${flight.flightId}"/>
      <%-- ✅ passengers matches @RequestParam int passengers --%>
      <input type="hidden" name="passengers"  id="passengersHidden" value="1"/>

      <div class="divider">
        <div class="divider-line"></div>
        <span class="divider-label">Trip Details</span>
        <div class="divider-line"></div>
      </div>

      <%-- ✅ journeyDate matches @RequestParam String journeyDate --%>
      <div class="form-group">
        <label for="journeyDate">Journey Date</label>
        <div class="input-wrap">
          <span class="input-icon">📅</span>
          <input type="date" id="journeyDate" name="journeyDate" required/>
        </div>
      </div>

      <div class="divider">
        <div class="divider-line"></div>
        <span class="divider-label">Passengers</span>
        <div class="divider-line"></div>
      </div>

      <div class="form-group">
        <label>Number of Passengers</label>
        <div class="passenger-counter">
          <button type="button" class="counter-btn" id="minusBtn">−</button>
          <span id="passengerDisplay">1</span>
          <button type="button" class="counter-btn" id="plusBtn">+</button>
          <span class="counter-label">passenger(s)</span>
        </div>
      </div>

      <div class="price-preview">
        <span class="price-label">💰 Estimated Total</span>
        <span class="price-total">&#8377;<span id="priceValue">—</span></span>
      </div>

      <button type="submit" class="btn-submit">
        <span>🎫</span><span>Confirm Booking</span>
      </button>

    </form>
  </div>
</div>

<script>
  /* Code Generated by Sidekick is for learning and experimentation purposes only. */
  (function () {
    const pricePerSeat = parseFloat('${flight.pricePerSeat}') || 0;
    const maxSeats     = parseInt('${flight.availableSeats}') || 10;
    const MAX          = Math.min(maxSeats, 10);
    let count          = 1;

    const display    = document.getElementById('passengerDisplay');
    const hidden     = document.getElementById('passengersHidden');
    const priceVal   = document.getElementById('priceValue');
    const minusBtn   = document.getElementById('minusBtn');
    const plusBtn    = document.getElementById('plusBtn');

    /* Set today as minimum selectable date */
    document.getElementById('journeyDate').setAttribute(
      'min', new Date().toISOString().split('T')[0]
    );

    function updateUI() {
      display.textContent = count;
      hidden.value        = count;
      priceVal.textContent = pricePerSeat
        ? (pricePerSeat * count).toLocaleString('en-IN')
        : '—';
      minusBtn.style.opacity = count === 1   ? '0.35' : '1';
      plusBtn.style.opacity  = count === MAX ? '0.35' : '1';
    }

    minusBtn.addEventListener('click', function () { if (count > 1)   { count--; updateUI(); } });
    plusBtn.addEventListener ('click', function () { if (count < MAX) { count++; updateUI(); } });

    updateUI();
  })();
</script>
</body>
</html>
