<%-- filename: user-dashboard.jsp --%>
<%@ page contentType="text/html;charset=UTF-8" %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>My Dashboard — SkyReserve</title>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    /* Code Generated by Sidekick is for learning and experimentation purposes only. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg-deep:     #0a0a0f;
      --bg-card:     rgba(255,255,255,0.04);
      --border:      rgba(255,255,255,0.08);
      --accent:      #6c63ff;
      --accent-2:    #00d4ff;
      --accent-glow: rgba(108,99,255,0.35);
      --cyan-glow:   rgba(0,212,255,0.25);
      --green:       #22c55e;
      --green-glow:  rgba(34,197,94,0.2);
      --danger:      #ef4444;
      --danger-glow: rgba(239,68,68,0.22);
      --text-1:      #f0f0f8;
      --text-2:      #9898b8;
    }

    body {
      min-height: 100vh;
      font-family: 'Open Sans', sans-serif;
      background: var(--bg-deep);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 32px 16px;
      overflow-x: hidden;
    }

    /* Background orbs */
    body::before, body::after {
      content: '';
      position: fixed;
      border-radius: 50%;
      filter: blur(130px);
      z-index: 0;
      pointer-events: none;
    }
    body::before {
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(108,99,255,0.18) 0%, transparent 70%);
      top: -150px; left: -150px;
      animation: drift1 12s ease-in-out infinite alternate;
    }
    body::after {
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(0,212,255,0.12) 0%, transparent 70%);
      bottom: -100px; right: -100px;
      animation: drift2 14s ease-in-out infinite alternate;
    }
    @keyframes drift1 { from { transform: translate(0,0); } to { transform: translate(60px,40px); } }
    @keyframes drift2 { from { transform: translate(0,0); } to { transform: translate(-50px,-30px); } }

    /* Pulse orb centre */
    .orb-mid {
      position: fixed;
      width: 420px; height: 420px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(0,212,255,0.07) 0%, transparent 70%);
      filter: blur(100px);
      top: 50%; left: 50%;
      transform: translate(-50%,-50%);
      pointer-events: none;
      z-index: 0;
      animation: pulse 9s ease-in-out infinite;
    }
    @keyframes pulse {
      0%,100% { opacity: 0.4; transform: translate(-50%,-50%) scale(1); }
      50%     { opacity: 0.9; transform: translate(-50%,-50%) scale(1.12); }
    }

    /* Main card */
    .dashboard {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 500px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 48px 40px;
      backdrop-filter: blur(24px);
      box-shadow:
        0 0 0 1px rgba(255,255,255,0.04),
        0 32px 64px rgba(0,0,0,0.5),
        0 0 80px var(--accent-glow);
      animation: fadeUp 0.6s cubic-bezier(0.22,1,0.36,1) both;
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(40px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Header */
    .dash-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin-bottom: 36px;
    }
    .avatar {
      width: 72px; height: 72px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 30px;
      margin-bottom: 16px;
      box-shadow: 0 8px 32px var(--accent-glow);
      position: relative;
    }
    .avatar-ring {
      position: absolute;
      inset: -4px;
      border-radius: 50%;
      border: 2px solid transparent;
      background: linear-gradient(135deg, var(--accent), var(--accent-2)) border-box;
      -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: destination-out;
      mask-composite: exclude;
      animation: spin 6s linear infinite;
    }
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

    .dash-header h1 {
      font-size: 24px;
      font-weight: 800;
      color: var(--text-1);
      letter-spacing: -0.4px;
    }
    .dash-header p {
      font-size: 13px;
      color: var(--text-2);
      margin-top: 6px;
      line-height: 1.5;
    }
    .user-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 10px;
      padding: 4px 14px;
      border-radius: 999px;
      background: rgba(34,197,94,0.1);
      border: 1px solid rgba(34,197,94,0.28);
      font-size: 11px;
      font-weight: 700;
      color: #86efac;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    .badge-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 6px var(--green);
      animation: blink 1.6s ease-in-out infinite;
    }
    @keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }

    /* Stats strip */
    .stats-strip {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 1px;
      background: var(--border);
      border-radius: 16px;
      overflow: hidden;
      margin-bottom: 32px;
    }
    .stat-cell {
      background: rgba(255,255,255,0.03);
      padding: 14px 10px;
      text-align: center;
      transition: background 0.2s;
    }
    .stat-cell:hover { background: rgba(108,99,255,0.07); }
    .stat-num {
      font-size: 19px;
      font-weight: 800;
      color: var(--text-1);
    }
    .stat-lbl {
      font-size: 10px;
      color: var(--text-2);
      text-transform: uppercase;
      letter-spacing: 0.7px;
      margin-top: 3px;
    }

    /* Divider */
    .divider {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
    }
    .divider-line { flex: 1; height: 1px; background: var(--border); }
    .divider-label {
      font-size: 11px;
      color: var(--text-2);
      letter-spacing: 1px;
      text-transform: uppercase;
      white-space: nowrap;
    }

    /* Nav cards */
    .nav-grid {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 20px;
    }
    .nav-card {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 18px 20px;
      border-radius: 16px;
      border: 1px solid var(--border);
      background: rgba(255,255,255,0.03);
      text-decoration: none;
      transition: transform 0.18s ease, box-shadow 0.18s ease,
                  border-color 0.18s ease, background 0.18s ease;
      animation: fadeUp 0.6s cubic-bezier(0.22,1,0.36,1) both;
    }
    .nav-card:nth-child(1) { animation-delay: 0.12s; }
    .nav-card:nth-child(2) { animation-delay: 0.22s; }

    .nav-card:hover {
      transform: translateY(-3px) scale(1.01);
      border-color: rgba(108,99,255,0.4);
      background: rgba(108,99,255,0.07);
      box-shadow: 0 8px 32px rgba(108,99,255,0.18);
    }

    .nav-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 48px; height: 48px;
      border-radius: 14px;
      font-size: 21px;
      flex-shrink: 0;
      transition: transform 0.2s ease;
    }
    .nav-card:hover .nav-icon { transform: scale(1.1) rotate(-5deg); }
    .icon-purple { background: rgba(108,99,255,0.14); }
    .icon-cyan   { background: rgba(0,212,255,0.11); }

    .nav-text { flex: 1; display: flex; flex-direction: column; gap: 3px; }
    .nav-title {
      font-size: 14px;
      font-weight: 700;
      color: var(--text-1);
    }
    .nav-sub {
      font-size: 12px;
      color: var(--text-2);
      font-weight: 400;
    }

    /* Pill tag on card */
    .nav-tag {
      font-size: 10px;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 999px;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      flex-shrink: 0;
    }
    .tag-new {
      background: rgba(108,99,255,0.15);
      border: 1px solid rgba(108,99,255,0.3);
      color: #a89fff;
    }
    .tag-live {
      background: rgba(34,197,94,0.12);
      border: 1px solid rgba(34,197,94,0.28);
      color: #86efac;
    }

    .nav-arrow {
      font-size: 20px;
      color: var(--text-2);
      transition: transform 0.18s, color 0.18s;
      margin-left: 4px;
    }
    .nav-card:hover .nav-arrow {
      transform: translateX(4px);
      color: var(--accent);
    }

    /* Logout */
    .btn-logout {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 14px;
      border-radius: 14px;
      border: 1px solid rgba(239,68,68,0.22);
      background: rgba(239,68,68,0.06);
      color: #fca5a5;
      font-family: 'Open Sans', sans-serif;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.18s, border-color 0.18s,
                  box-shadow 0.18s, transform 0.18s;
      animation: fadeUp 0.6s 0.32s cubic-bezier(0.22,1,0.36,1) both;
    }
    .btn-logout:hover {
      background: rgba(239,68,68,0.13);
      border-color: rgba(239,68,68,0.48);
      box-shadow: 0 6px 24px var(--danger-glow);
      transform: translateY(-2px);
    }

    /* Footer */
    .dash-footer {
      text-align: center;
      margin-top: 24px;
      font-size: 11px;
      color: #55557a;
      letter-spacing: 0.3px;
    }

    @media (max-width: 480px) {
      .dashboard { padding: 32px 20px; }
      .dash-header h1 { font-size: 20px; }
    }
  </style>
</head>
<body>

<div class="orb-mid"></div>

<div class="dashboard">

  <!-- Header -->
  <div class="dash-header">
    <div class="avatar">
      👤
      <div class="avatar-ring"></div>
    </div>
    <h1>My Dashboard</h1>
    <p>Manage your flights, bookings &amp; travel history</p>
    <span class="user-badge">
      <span class="badge-dot"></span>
      Active Session
    </span>
  </div>

  <!-- Stats strip -->
  <div class="stats-strip">
    <div class="stat-cell">
      <div class="stat-num">✈️ 3</div>
      <div class="stat-lbl">Upcoming</div>
    </div>
    <div class="stat-cell">
      <div class="stat-num">📋 7</div>
      <div class="stat-lbl">Total Trips</div>
    </div>
    <div class="stat-cell">
      <div class="stat-num">⭐ 4.9</div>
      <div class="stat-lbl">Rating</div>
    </div>
  </div>

  <!-- Quick actions -->
  <div class="divider">
    <div class="divider-line"></div>
    <span class="divider-label">Quick Actions</span>
    <div class="divider-line"></div>
  </div>

  <div class="nav-grid">

    <a href="${pageContext.request.contextPath}/" class="nav-card">
      <div class="nav-icon icon-purple">🔍</div>
      <div class="nav-text">
        <span class="nav-title">Search Flights</span>
        <span class="nav-sub">Find and book new routes</span>
      </div>
      <span class="nav-tag tag-live">Live</span>
      <span class="nav-arrow">›</span>
    </a>

    <a href="${pageContext.request.contextPath}/user/bookings" class="nav-card">
      <div class="nav-icon icon-cyan">🎫</div>
      <div class="nav-text">
        <span class="nav-title">My Bookings</span>
        <span class="nav-sub">View and manage your reservations</span>
      </div>
      <span class="nav-tag tag-new">3 New</span>
      <span class="nav-arrow">›</span>
    </a>

  </div>

  <!-- Logout -->
  <a href="${pageContext.request.contextPath}/logout" class="btn-logout">
    <span>🚪</span>
    <span>Logout</span>
  </a>

  <div class="dash-footer">SkyReserve &nbsp;•&nbsp; Safe &amp; Secure Travel 🛡️</div>

</div>

</body>
</html>
