<%-- filename: 404.jsp --%>
<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>404 — Page Not Found | SkyReserve</title>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    /* Code Generated by Sidekick is for learning and experimentation purposes only. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg-deep:     #0a0a0f;
      --bg-card:     rgba(255,255,255,0.04);
      --border:      rgba(255,255,255,0.08);
      --accent:      #6c63ff;
      --accent-2:    #00d4ff;
      --accent-glow: rgba(108,99,255,0.35);
      --text-1:      #f0f0f8;
      --text-2:      #9898b8;
      --text-3:      #55557a;
    }

    body {
      min-height: 100vh;
      font-family: 'Open Sans', sans-serif;
      background: var(--bg-deep);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 32px 20px;
      overflow: hidden;
    }

    /* ── Background orbs ── */
    body::before, body::after {
      content: '';
      position: fixed;
      border-radius: 50%;
      filter: blur(130px);
      z-index: 0;
      pointer-events: none;
    }
    body::before {
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(108,99,255,0.18) 0%, transparent 70%);
      top: -160px; left: -160px;
      animation: drift1 12s ease-in-out infinite alternate;
    }
    body::after {
      width: 520px; height: 520px;
      background: radial-gradient(circle, rgba(0,212,255,0.12) 0%, transparent 70%);
      bottom: -120px; right: -120px;
      animation: drift2 15s ease-in-out infinite alternate;
    }
    @keyframes drift1 { from{transform:translate(0,0);}   to{transform:translate(60px,40px);} }
    @keyframes drift2 { from{transform:translate(0,0);}   to{transform:translate(-50px,-30px);} }

    /* Centre pulse orb */
    .orb-mid {
      position: fixed;
      width: 500px; height: 500px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(108,99,255,0.07) 0%, transparent 70%);
      filter: blur(110px);
      top: 50%; left: 50%;
      transform: translate(-50%,-50%);
      pointer-events: none;
      z-index: 0;
      animation: pulse 9s ease-in-out infinite;
    }
    @keyframes pulse {
      0%,100% { opacity: 0.4; transform: translate(-50%,-50%) scale(1); }
      50%     { opacity: 1;   transform: translate(-50%,-50%) scale(1.15); }
    }

    /* ── Floating plane animation ── */
    .plane-wrap {
      position: relative;
      z-index: 1;
      margin-bottom: 32px;
      animation: fadeUp 0.6s cubic-bezier(0.22,1,0.36,1) both;
    }
    .plane-float {
      font-size: 72px;
      display: block;
      animation: float 4s ease-in-out infinite;
      filter: drop-shadow(0 0 32px rgba(108,99,255,0.6));
    }
    @keyframes float {
      0%,100% { transform: translateY(0) rotate(-8deg); }
      50%     { transform: translateY(-18px) rotate(-4deg); }
    }

    /* Trail dots */
    .trail {
      display: flex;
      gap: 6px;
      justify-content: flex-end;
      margin-top: -8px;
      padding-right: 12px;
      animation: fadeIn 1s 0.5s both;
    }
    .trail span {
      display: block;
      border-radius: 50%;
      background: var(--accent);
      opacity: 0.5;
      animation: trailPulse 1.4s ease-in-out infinite;
    }
    .trail span:nth-child(1) { width:6px; height:6px; animation-delay:0s; }
    .trail span:nth-child(2) { width:5px; height:5px; animation-delay:0.15s; }
    .trail span:nth-child(3) { width:4px; height:4px; animation-delay:0.3s; }
    .trail span:nth-child(4) { width:3px; height:3px; animation-delay:0.45s; }
    @keyframes trailPulse {
      0%,100% { opacity:0.5; transform:scale(1); }
      50%     { opacity:0.15; transform:scale(0.7); }
    }

    /* ── 404 number ── */
    .error-code {
      position: relative;
      z-index: 1;
      font-size: clamp(96px, 20vw, 160px);
      font-weight: 800;
      line-height: 1;
      letter-spacing: -6px;
      background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      text-shadow: none;
      animation: fadeUp 0.6s 0.1s cubic-bezier(0.22,1,0.36,1) both;
      user-select: none;
    }
    /* Glitch effect on hover */
    .error-code:hover { animation: glitch 0.4s steps(1) both; }
    @keyframes glitch {
      0%   { text-shadow: 2px 0 #6c63ff, -2px 0 #00d4ff; transform: skewX(0deg); }
      20%  { text-shadow: -2px 0 #6c63ff,  2px 0 #00d4ff; transform: skewX(-2deg); }
      40%  { text-shadow:  3px 0 #6c63ff, -3px 0 #00d4ff; transform: skewX(1deg); }
      60%  { text-shadow: -3px 0 #6c63ff,  3px 0 #00d4ff; transform: skewX(-1deg); }
      80%  { text-shadow:  1px 0 #6c63ff, -1px 0 #00d4ff; transform: skewX(0.5deg); }
      100% { text-shadow: none; transform: skewX(0deg); }
    }

    /* ── Text block ── */
    .error-content {
      position: relative;
      z-index: 1;
      text-align: center;
      max-width: 420px;
      animation: fadeUp 0.6s 0.18s cubic-bezier(0.22,1,0.36,1) both;
    }
    .error-content h1 {
      font-size: 24px;
      font-weight: 800;
      color: var(--text-1);
      letter-spacing: -0.4px;
      margin-bottom: 12px;
    }
    .error-content p {
      font-size: 14px;
      color: var(--text-2);
      line-height: 1.75;
      margin-bottom: 8px;
    }

    /* ── Status badge ── */
    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 5px 14px;
      border-radius: 999px;
      background: rgba(239,68,68,0.1);
      border: 1px solid rgba(239,68,68,0.28);
      font-size: 11px;
      font-weight: 700;
      color: #fca5a5;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 28px;
    }
    .status-dot-red {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: #ef4444;
      box-shadow: 0 0 6px #ef4444;
      animation: blink 1.4s ease-in-out infinite;
    }
    @keyframes blink { 0%,100%{opacity:1;} 50%{opacity:0.25;} }

    /* ── CTA buttons ── */
    .cta-group {
      position: relative;
      z-index: 1;
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 32px;
      animation: fadeUp 0.6s 0.28s cubic-bezier(0.22,1,0.36,1) both;
    }
    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 14px 28px;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      border: none;
      color: #fff;
      font-family: 'Open Sans', sans-serif;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      box-shadow: 0 8px 28px var(--accent-glow);
      transition: transform 0.18s, filter 0.18s, box-shadow 0.18s;
    }
    .btn-primary:hover {
      transform: translateY(-3px);
      filter: brightness(1.1);
      box-shadow: 0 14px 36px var(--accent-glow);
    }
    .btn-primary:active { transform: translateY(0); }

    .btn-ghost {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 13px 24px;
      border-radius: 14px;
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--border);
      color: var(--text-2);
      font-family: 'Open Sans', sans-serif;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.18s, border-color 0.18s, color 0.18s, transform 0.18s;
    }
    .btn-ghost:hover {
      background: rgba(108,99,255,0.1);
      border-color: rgba(108,99,255,0.35);
      color: var(--text-1);
      transform: translateY(-2px);
    }

    /* ── Quick links card ── */
    .quick-card {
      position: relative;
      z-index: 1;
      margin-top: 48px;
      width: 100%;
      max-width: 440px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 24px 28px;
      backdrop-filter: blur(20px);
      box-shadow: 0 16px 48px rgba(0,0,0,0.35);
      animation: fadeUp 0.6s 0.36s cubic-bezier(0.22,1,0.36,1) both;
    }
    .quick-title {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-3);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 16px;
    }
    .quick-links {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .quick-link {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 12px 14px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: rgba(255,255,255,0.02);
      text-decoration: none;
      transition: background 0.18s, border-color 0.18s, transform 0.18s;
    }
    .quick-link:hover {
      background: rgba(108,99,255,0.08);
      border-color: rgba(108,99,255,0.3);
      transform: translateX(4px);
    }
    .ql-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px; height: 36px;
      border-radius: 10px;
      font-size: 16px;
      flex-shrink: 0;
    }
    .ql-icon-purple { background: rgba(108,99,255,0.14); }
    .ql-icon-cyan   { background: rgba(0,212,255,0.11); }
    .ql-icon-green  { background: rgba(34,197,94,0.11); }

    .ql-text { flex: 1; }
    .ql-name {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-1);
    }
    .ql-desc {
      font-size: 11px;
      color: var(--text-2);
      margin-top: 2px;
    }
    .ql-arrow {
      font-size: 18px;
      color: var(--text-3);
      transition: transform 0.18s, color 0.18s;
    }
    .quick-link:hover .ql-arrow {
      transform: translateX(4px);
      color: var(--accent);
    }

    /* ── Footer ── */
    .page-footer {
      position: relative;
      z-index: 1;
      margin-top: 40px;
      font-size: 11px;
      color: var(--text-3);
      letter-spacing: 0.3px;
      text-align: center;
      animation: fadeUp 0.6s 0.44s cubic-bezier(0.22,1,0.36,1) both;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(28px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }

    @media (max-width: 480px) {
      .error-code { letter-spacing: -3px; }
      .cta-group { flex-direction: column; align-items: center; }
      .btn-primary, .btn-ghost { width: 100%; justify-content: center; }
    }
  </style>
</head>
<body>

<div class="orb-mid"></div>

<!-- Floating plane -->
<div class="plane-wrap">
  <span class="plane-float">✈️</span>
  <div class="trail">
    <span></span><span></span><span></span><span></span>
  </div>
</div>

<!-- 404 code -->
<div class="error-code">404</div>

<!-- Error text -->
<div class="error-content">
  <span class="status-pill">
    <span class="status-dot-red"></span>
    Flight Not Found
  </span>
  <h1>You've Flown Off Course</h1>
  <p>
    The page you're looking for has taken off without you —
    or it never existed at all. Let's get you back on track.
  </p>
</div>

<!-- CTA buttons -->
<div class="cta-group">
  <a href="${pageContext.request.contextPath}/" class="btn-primary">
    🏠 &nbsp;Back to Home
  </a>
  <a href="javascript:history.back()" class="btn-ghost">
    ← &nbsp;Go Back
  </a>
</div>

<!-- Quick links -->
<div class="quick-card">
  <div class="quick-title">🗺️ &nbsp;Where would you like to go?</div>
  <div class="quick-links">

    <a href="${pageContext.request.contextPath}/" class="quick-link">
      <div class="ql-icon ql-icon-purple">🔍</div>
      <div class="ql-text">
        <div class="ql-name">Search Flights</div>
        <div class="ql-desc">Find and book your next journey</div>
      </div>
      <span class="ql-arrow">›</span>
    </a>

    <a href="${pageContext.request.contextPath}/user/dashboard" class="quick-link">
      <div class="ql-icon ql-icon-cyan">👤</div>
      <div class="ql-text">
        <div class="ql-name">My Dashboard</div>
        <div class="ql-desc">View your bookings and profile</div>
      </div>
      <span class="ql-arrow">›</span>
    </a>

    <a href="${pageContext.request.contextPath}/login" class="quick-link">
      <div class="ql-icon ql-icon-green">🔑</div>
      <div class="ql-text">
        <div class="ql-name">Login</div>
        <div class="ql-desc">Sign in to your account</div>
      </div>
      <span class="ql-arrow">›</span>
    </a>

  </div>
</div>

<div class="page-footer">SkyReserve &nbsp;•&nbsp; Error 404 &nbsp;•&nbsp; Page Not Found 🛡️</div>

</body>
</html>
