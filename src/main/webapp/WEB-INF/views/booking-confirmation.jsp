<%-- filename: booking-confirmation.jsp --%>
<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c"  uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Booking Confirmed — SkyReserve</title>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    /* Code Generated by Sidekick is for learning and experimentation purposes only. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg-deep:     #0a0a0f;
      --bg-card:     rgba(255,255,255,0.04);
      --border:      rgba(255,255,255,0.08);
      --accent:      #6c63ff;
      --accent-2:    #00d4ff;
      --accent-glow: rgba(108,99,255,0.35);
      --green:       #22c55e;
      --green-glow:  rgba(34,197,94,0.25);
      --text-1:      #f0f0f8;
      --text-2:      #9898b8;
      --text-3:      #55557a;
    }

    body {
      min-height: 100vh;
      font-family: 'Open Sans', sans-serif;
      background: var(--bg-deep);
      padding: 40px 20px 64px;
      overflow-x: hidden;
    }

    body::before, body::after {
      content: '';
      position: fixed;
      border-radius: 50%;
      filter: blur(130px);
      z-index: 0;
      pointer-events: none;
    }
    body::before {
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(108,99,255,0.17) 0%, transparent 70%);
      top: -150px; left: -150px;
      animation: drift1 12s ease-in-out infinite alternate;
    }
    body::after {
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(34,197,94,0.12) 0%, transparent 70%);
      bottom: -100px; right: -100px;
      animation: drift2 15s ease-in-out infinite alternate;
    }
    @keyframes drift1 { from{transform:translate(0,0);} to{transform:translate(60px,40px);} }
    @keyframes drift2 { from{transform:translate(0,0);} to{transform:translate(-50px,-30px);} }

    .page {
      position: relative;
      z-index: 1;
      max-width: 700px;
      margin: 0 auto;
    }

    /* ── Success hero ── */
    .success-hero {
      text-align: center;
      margin-bottom: 40px;
      animation: fadeUp 0.6s cubic-bezier(0.22,1,0.36,1) both;
    }
    .success-ring {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 96px; height: 96px;
      border-radius: 50%;
      background: rgba(34,197,94,0.12);
      border: 2px solid rgba(34,197,94,0.35);
      font-size: 42px;
      margin-bottom: 20px;
      box-shadow: 0 0 0 8px rgba(34,197,94,0.07),
                  0 0 40px var(--green-glow);
      animation: pop 0.5s 0.2s cubic-bezier(0.34,1.56,0.64,1) both;
    }
    @keyframes pop {
      from { transform: scale(0.5); opacity: 0; }
      to   { transform: scale(1);   opacity: 1; }
    }
    .success-hero h1 {
      font-size: 28px;
      font-weight: 800;
      color: var(--text-1);
      letter-spacing: -0.5px;
    }
    .success-hero p {
      font-size: 14px;
      color: var(--text-2);
      margin-top: 8px;
      line-height: 1.7;
    }
    .confirmed-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-top: 14px;
      padding: 6px 18px;
      border-radius: 999px;
      background: rgba(34,197,94,0.12);
      border: 1px solid rgba(34,197,94,0.3);
      font-size: 12px;
      font-weight: 700;
      color: #86efac;
      letter-spacing: 0.5px;
    }
    .badge-dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 6px var(--green);
      animation: blink 1.6s ease-in-out infinite;
    }
    @keyframes blink { 0%,100%{opacity:1;} 50%{opacity:0.3;} }

    /* ── Booking summary card ── */
    .summary-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 22px;
      overflow: hidden;
      backdrop-filter: blur(20px);
      box-shadow: 0 16px 48px rgba(0,0,0,0.4);
      margin-bottom: 28px;
      animation: fadeUp 0.6s 0.1s cubic-bezier(0.22,1,0.36,1) both;
    }
    .summary-card::before {
      content: '';
      display: block;
      height: 3px;
      background: linear-gradient(90deg, var(--green), #86efac);
    }
    .card-head {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 20px 28px 16px;
      border-bottom: 1px solid var(--border);
    }
    .card-head-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px; height: 44px;
      border-radius: 13px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      font-size: 20px;
      box-shadow: 0 4px 16px var(--accent-glow);
      flex-shrink: 0;
    }
    .card-head-text { display: flex; flex-direction: column; gap: 2px; }
    .card-head-label {
      font-size: 10px;
      font-weight: 700;
      color: var(--text-3);
      text-transform: uppercase;
      letter-spacing: 0.9px;
    }
    .card-head-id {
      font-size: 17px;
      font-weight: 800;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Summary grid */
    .summary-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }
    .summary-cell {
      padding: 20px 28px;
      border-right: 1px solid var(--border);
    }
    .summary-cell:last-child { border-right: none; }
    .cell-label {
      font-size: 10px;
      font-weight: 700;
      color: var(--text-3);
      text-transform: uppercase;
      letter-spacing: 0.9px;
      margin-bottom: 7px;
    }
    .cell-value {
      font-size: 15px;
      font-weight: 700;
      color: var(--text-1);
    }
    .price-value {
      font-size: 20px;
      font-weight: 800;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .seat-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 12px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 700;
      background: rgba(108,99,255,0.12);
      border: 1px solid rgba(108,99,255,0.28);
      color: #c4c0ff;
    }

    /* ── Section header ── */
    .section-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 16px;
      animation: fadeUp 0.6s 0.18s cubic-bezier(0.22,1,0.36,1) both;
    }
    .section-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px; height: 36px;
      border-radius: 10px;
      background: rgba(108,99,255,0.14);
      font-size: 16px;
    }
    .section-title {
      font-size: 16px;
      font-weight: 800;
      color: var(--text-1);
    }
    .section-count {
      margin-left: auto;
      padding: 3px 12px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      background: rgba(108,99,255,0.12);
      border: 1px solid rgba(108,99,255,0.28);
      color: #a89fff;
    }

    /* ── Ticket cards ── */
    .tickets-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-bottom: 32px;
    }

    .ticket-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 18px;
      overflow: hidden;
      backdrop-filter: blur(16px);
      box-shadow: 0 8px 28px rgba(0,0,0,0.3);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      animation: fadeUp 0.55s cubic-bezier(0.22,1,0.36,1) both;
    }
    .ticket-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 40px rgba(0,0,0,0.4),
                  0 0 30px rgba(108,99,255,0.1);
    }
    .ticket-card::before {
      content: '';
      display: block;
      height: 2px;
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
    }

    /* Tear line */
    .tear {
      position: relative;
      height: 1px;
      background: var(--border);
      margin: 0 24px;
      overflow: visible;
    }
    .tear::before, .tear::after {
      content: '';
      position: absolute;
      top: 50%;
      width: 18px; height: 18px;
      border-radius: 50%;
      background: var(--bg-deep);
      border: 1px solid var(--border);
      transform: translateY(-50%);
    }
    .tear::before { left: -33px; }
    .tear::after  { right: -33px; }

    .ticket-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 24px 14px;
      flex-wrap: wrap;
      gap: 10px;
    }
    .ticket-pnr {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .pnr-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 8px var(--accent);
      flex-shrink: 0;
    }
    .pnr-label {
      font-size: 10px;
      font-weight: 700;
      color: var(--text-3);
      text-transform: uppercase;
      letter-spacing: 0.8px;
    }
    .pnr-num {
      font-size: 14px;
      font-weight: 800;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      letter-spacing: 0.5px;
    }
    .seat-tag {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 12px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      background: rgba(108,99,255,0.12);
      border: 1px solid rgba(108,99,255,0.28);
      color: #c4c0ff;
    }

    /* Ticket info grid */
    .ticket-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    }
    .t-cell {
      padding: 14px 24px;
      border-right: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .t-cell:last-child,
    .t-cell:nth-last-child(2),
    .t-cell:nth-last-child(3) { border-bottom: none; }
    .t-cell:nth-child(3n)     { border-right: none; }
    .t-label {
      font-size: 10px;
      font-weight: 700;
      color: var(--text-3);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 5px;
    }
    .t-value {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-1);
    }

    /* ── CTA buttons ── */
    .cta-row {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      animation: fadeUp 0.6s 0.35s cubic-bezier(0.22,1,0.36,1) both;
    }
    .btn-primary {
      flex: 1;
      min-width: 180px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      padding: 14px 24px;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      color: #fff;
      font-family: 'Open Sans', sans-serif;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      box-shadow: 0 8px 28px var(--accent-glow);
      transition: transform 0.18s, filter 0.18s;
    }
    .btn-primary:hover { transform: translateY(-2px); filter: brightness(1.1); }

    .btn-ghost {
      flex: 1;
      min-width: 160px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      padding: 13px 24px;
      border-radius: 14px;
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--border);
      color: var(--text-2);
      font-family: 'Open Sans', sans-serif;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.18s, border-color 0.18s, color 0.18s, transform 0.18s;
    }
    .btn-ghost:hover {
      background: rgba(108,99,255,0.1);
      border-color: rgba(108,99,255,0.35);
      color: var(--text-1);
      transform: translateY(-2px);
    }

    .page-footer {
      text-align: center;
      margin-top: 48px;
      font-size: 11px;
      color: var(--text-3);
      animation: fadeUp 0.6s 0.45s cubic-bezier(0.22,1,0.36,1) both;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 560px) {
      .summary-grid { grid-template-columns: 1fr 1fr; }
      .summary-cell:nth-child(2) { border-right: none; }
      .summary-cell:last-child { border-top: 1px solid var(--border); grid-column: span 2; }
      .ticket-grid { grid-template-columns: 1fr 1fr; }
      .t-cell:nth-child(3n) { border-right: 1px solid var(--border); }
      .t-cell:nth-child(2n) { border-right: none; }
    }
  </style>
</head>
<body>
<div class="page">

  <!-- Success hero -->
  <div class="success-hero">
    <div class="success-ring">✅</div>
    <h1>Booking Confirmed!</h1>
    <p>Your seats are reserved. Have a great flight!</p>
    <span class="confirmed-badge">
      <span class="badge-dot"></span>
      Payment Successful &amp; Tickets Issued
    </span>
  </div>

  <!-- Booking summary card -->
  <div class="summary-card">
    <div class="card-head">
      <div class="card-head-icon">🎫</div>
      <div class="card-head-text">
        <span class="card-head-label">Booking Reference</span>
        <span class="card-head-id">#BK-${booking.bookingId}</span>
      </div>
    </div>
    <div class="summary-grid">
      <div class="summary-cell">
        <div class="cell-label">Journey Date</div>
        <div class="cell-value">📅 ${booking.journeyDate}</div>
      </div>
      <div class="summary-cell">
        <div class="cell-label">Seats Booked</div>
        <div class="cell-value">
          <span class="seat-pill">💺 ${booking.seats}</span>
        </div>
      </div>
      <div class="summary-cell">
        <div class="cell-label">Total Paid</div>
        <div class="cell-value">
          <span class="price-value">&#8377;${booking.totalPrice}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Tickets section -->
  <div class="section-header">
    <div class="section-icon">🎟️</div>
    <span class="section-title">Your Tickets</span>
    <span class="section-count">${fn:length(tickets)} Passenger(s)</span>
  </div>

  <div class="tickets-list">
    <c:forEach var="ticket" items="${tickets}" varStatus="loop">
      <c:set var="delay" value="${loop.index * 0.08}"/>

      <div class="ticket-card" style="animation-delay:${delay}s">

        <div class="ticket-header">
          <div class="ticket-pnr">
            <span class="pnr-dot"></span>
            <div>
              <div class="pnr-label">PNR Number</div>
              <div class="pnr-num">${ticket.pnrNo}</div>
            </div>
          </div>
          <span class="seat-tag">💺 Seat ${ticket.seatNo}</span>
        </div>

        <div class="tear"></div>

        <div class="ticket-grid">
          <div class="t-cell">
            <div class="t-label">Passenger</div>
            <div class="t-value">👤 ${ticket.passengerName}</div>
          </div>
          <div class="t-cell">
            <div class="t-label">Age</div>
            <div class="t-value">🎂 ${ticket.age} yrs</div>
          </div>
          <div class="t-cell">
            <div class="t-label">Gender</div>
            <c:choose>
              <c:when test="${fn:toLowerCase(ticket.gender) == 'male'}">
                <div class="t-value">♂ ${ticket.gender}</div>
              </c:when>
              <c:when test="${fn:toLowerCase(ticket.gender) == 'female'}">
                <div class="t-value">♀ ${ticket.gender}</div>
              </c:when>
              <c:otherwise>
                <div class="t-value">⚧ ${ticket.gender}</div>
              </c:otherwise>
            </c:choose>
          </div>
        </div>

      </div>
    </c:forEach>
  </div>

  <!-- CTA buttons -->
  <div class="cta-row">
    <a href="${pageContext.request.contextPath}/user/dashboard" class="btn-primary">
      🏠 &nbsp;Go to Dashboard
    </a>
    <a href="${pageContext.request.contextPath}/user/tickets?bookingId=${booking.bookingId}" class="btn-ghost">Bas ?bookingId=${booking.bookingId} 
      🎟️ &nbsp;View All Tickets
    </a>
  </div>

  <div class="page-footer">SkyReserve &nbsp;•&nbsp; Safe Travels &amp; Happy Landings 🛡️</div>

</div>
</body>
</html>
