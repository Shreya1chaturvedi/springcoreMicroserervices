<%-- filename: signup.jsp --%>
<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Sign Up — SkyReserve</title>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    /* Code Generated by Sidekick is for learning and experimentation purposes only. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg-deep:     #0a0a0f;
      --bg-card:     rgba(255,255,255,0.04);
      --border:      rgba(255,255,255,0.08);
      --accent:      #6c63ff;
      --accent-2:    #00d4ff;
      --accent-glow: rgba(108,99,255,0.35);
      --green:       #22c55e;
      --green-glow:  rgba(34,197,94,0.22);
      --amber:       #f59e0b;
      --danger:      #ef4444;
      --text-1:      #f0f0f8;
      --text-2:      #9898b8;
      --text-3:      #55557a;
      --input-bg:    rgba(255,255,255,0.05);
      --input-focus: rgba(108,99,255,0.15);
    }

    body {
      min-height: 100vh;
      font-family: 'Open Sans', sans-serif;
      background: var(--bg-deep);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px 16px;
      overflow-x: hidden;
    }

    /* Background orbs */
    body::before, body::after {
      content: '';
      position: fixed;
      border-radius: 50%;
      filter: blur(130px);
      z-index: 0;
      pointer-events: none;
    }
    body::before {
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(108,99,255,0.18) 0%, transparent 70%);
      top: -150px; left: -150px;
      animation: drift1 12s ease-in-out infinite alternate;
    }
    body::after {
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(0,212,255,0.12) 0%, transparent 70%);
      bottom: -100px; right: -100px;
      animation: drift2 14s ease-in-out infinite alternate;
    }
    @keyframes drift1 { from{transform:translate(0,0);}  to{transform:translate(60px,40px);} }
    @keyframes drift2 { from{transform:translate(0,0);}  to{transform:translate(-50px,-30px);} }

    /* Card */
    .card {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 480px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 48px 40px;
      backdrop-filter: blur(24px);
      box-shadow:
        0 0 0 1px rgba(255,255,255,0.04),
        0 32px 64px rgba(0,0,0,0.5),
        0 0 80px var(--accent-glow);
      animation: fadeUp 0.6s cubic-bezier(0.22,1,0.36,1) both;
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(40px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Header */
    .card-header {
      text-align: center;
      margin-bottom: 36px;
    }
    .header-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 68px; height: 68px;
      border-radius: 22px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      font-size: 28px;
      margin-bottom: 18px;
      box-shadow: 0 8px 32px var(--accent-glow);
    }
    .card-header h1 {
      font-size: 26px;
      font-weight: 800;
      color: var(--text-1);
      letter-spacing: -0.5px;
    }
    .card-header p {
      font-size: 13px;
      color: var(--text-2);
      margin-top: 6px;
      line-height: 1.6;
    }

    /* Step indicator */
    .steps {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      margin-bottom: 32px;
    }
    .step {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
    }
    .step-circle {
      width: 32px; height: 32px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 800;
      border: 2px solid var(--border);
      color: var(--text-3);
      transition: all 0.3s;
    }
    .step.active .step-circle {
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      border-color: transparent;
      color: #fff;
      box-shadow: 0 4px 16px var(--accent-glow);
    }
    .step.done .step-circle {
      background: rgba(34,197,94,0.15);
      border-color: rgba(34,197,94,0.4);
      color: var(--green);
    }
    .step-label {
      font-size: 10px;
      font-weight: 700;
      color: var(--text-3);
      text-transform: uppercase;
      letter-spacing: 0.6px;
    }
    .step.active .step-label { color: #a89fff; }
    .step.done  .step-label  { color: #86efac; }
    .step-line {
      flex: 1;
      height: 2px;
      background: var(--border);
      margin: 0 8px;
      margin-bottom: 20px;
      max-width: 56px;
    }

    /* Error banner */
    .error-banner {
      display: flex;
      align-items: center;
      gap: 10px;
      background: rgba(239,68,68,0.1);
      border: 1px solid rgba(239,68,68,0.28);
      color: #fca5a5;
      border-radius: 12px;
      padding: 13px 16px;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 28px;
      animation: shake 0.4s cubic-bezier(0.36,0.07,0.19,0.97) both;
    }
    @keyframes shake {
      10%,90%       { transform: translateX(-2px); }
      20%,80%       { transform: translateX( 4px); }
      30%,50%,70%   { transform: translateX(-4px); }
      40%,60%       { transform: translateX( 4px); }
    }

    /* Form groups */
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 20px;
    }
    label {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-2);
      letter-spacing: 0.8px;
      text-transform: uppercase;
    }
    .input-wrap {
      position: relative;
      display: flex;
      align-items: center;
    }
    .input-icon {
      position: absolute;
      left: 14px;
      font-size: 15px;
      pointer-events: none;
      color: var(--text-2);
      transition: color 0.2s;
      z-index: 1;
    }
    .input-wrap:focus-within .input-icon { color: var(--accent); }

    input[type="email"],
    input[type="password"],
    input[type="text"] {
      width: 100%;
      padding: 14px 14px 14px 42px;
      background: var(--input-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      color: var(--text-1);
      font-family: 'Open Sans', sans-serif;
      font-size: 14px;
      font-weight: 600;
      outline: none;
      transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
    }
    input::placeholder { color: #55557a; font-weight: 400; }
    input:focus {
      border-color: var(--accent);
      background: var(--input-focus);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }

    /* Password toggle */
    .toggle-pw {
      position: absolute;
      right: 14px;
      background: none;
      border: none;
      color: var(--text-2);
      cursor: pointer;
      font-size: 16px;
      padding: 4px;
      display: flex;
      align-items: center;
      transition: color 0.2s;
      z-index: 1;
    }
    .toggle-pw:hover { color: var(--accent); }
    .input-wrap input[type="password"],
    .input-wrap input[type="text"] { padding-right: 46px; }

    /* Password strength meter */
    .strength-wrap { margin-top: 10px; }
    .strength-bars {
      display: flex;
      gap: 5px;
      margin-bottom: 6px;
    }
    .strength-bar {
      height: 4px;
      flex: 1;
      border-radius: 99px;
      background: var(--border);
      transition: background 0.35s ease;
    }
    .strength-text {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-3);
      transition: color 0.35s;
      min-height: 14px;
    }

    /* ── Role selector cards ── */
    .role-label {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-2);
      letter-spacing: 0.8px;
      text-transform: uppercase;
      margin-bottom: 10px;
      display: block;
    }
    .role-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 24px;
    }
    .role-card {
      position: relative;
      cursor: pointer;
    }
    .role-card input[type="radio"] {
      position: absolute;
      opacity: 0;
      width: 0; height: 0;
    }
    .role-tile {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 20px 16px;
      border-radius: 16px;
      border: 2px solid var(--border);
      background: rgba(255,255,255,0.03);
      cursor: pointer;
      transition: border-color 0.2s, background 0.2s,
                  box-shadow 0.2s, transform 0.2s;
      user-select: none;
    }
    .role-tile:hover {
      border-color: rgba(108,99,255,0.35);
      background: rgba(108,99,255,0.06);
      transform: translateY(-2px);
    }
    .role-card input:checked ~ .role-tile {
      border-color: var(--accent);
      background: rgba(108,99,255,0.12);
      box-shadow: 0 0 0 3px var(--accent-glow), 0 8px 24px rgba(108,99,255,0.15);
      transform: translateY(-2px);
    }
    .role-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 48px; height: 48px;
      border-radius: 14px;
      font-size: 22px;
      background: rgba(255,255,255,0.05);
      transition: background 0.2s, transform 0.2s;
    }
    .role-card input:checked ~ .role-tile .role-icon {
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      transform: scale(1.1);
      box-shadow: 0 4px 16px var(--accent-glow);
    }
    .role-name {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-1);
    }
    .role-desc {
      font-size: 11px;
      color: var(--text-2);
      text-align: center;
      line-height: 1.4;
    }
    /* Check mark */
    .role-check {
      position: absolute;
      top: 10px; right: 10px;
      width: 20px; height: 20px;
      border-radius: 50%;
      background: var(--border);
      border: 2px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      transition: background 0.2s, border-color 0.2s;
    }
    .role-card input:checked ~ .role-tile .role-check {
      background: var(--accent);
      border-color: var(--accent);
      box-shadow: 0 0 8px var(--accent-glow);
    }

    /* Submit */
    .btn-submit {
      width: 100%;
      padding: 15px;
      background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 100%);
      border: none;
      border-radius: 14px;
      color: #fff;
      font-family: 'Open Sans', sans-serif;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.3px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow: 0 8px 32px var(--accent-glow);
      transition: transform 0.15s, box-shadow 0.15s, filter 0.15s;
    }
    .btn-submit:hover {
      transform: translateY(-2px);
      filter: brightness(1.1);
      box-shadow: 0 14px 40px var(--accent-glow);
    }
    .btn-submit:active { transform: translateY(0); }

    /* Divider */
    .divider {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 28px 0 22px;
    }
    .divider-line { flex: 1; height: 1px; background: var(--border); }
    .divider-label {
      font-size: 11px;
      color: var(--text-2);
      letter-spacing: 1px;
      text-transform: uppercase;
      white-space: nowrap;
    }

    /* Login link */
    .login-row {
      text-align: center;
      font-size: 13px;
      color: var(--text-2);
    }
    .login-row a {
      color: #a89fff;
      text-decoration: none;
      font-weight: 700;
      transition: color 0.2s;
    }
    .login-row a:hover { color: var(--accent-2); }

    /* Terms note */
    .terms-note {
      text-align: center;
      font-size: 11px;
      color: var(--text-3);
      margin-top: 18px;
      line-height: 1.6;
    }
    .terms-note a {
      color: #a89fff;
      text-decoration: none;
      font-weight: 600;
    }
    .terms-note a:hover { color: var(--accent-2); }

    @media (max-width: 480px) {
      .card { padding: 32px 20px; }
      .role-grid { grid-template-columns: 1fr 1fr; }
    }
  </style>
</head>
<body>

<div class="card">

  <!-- Header -->
  <div class="card-header">
    <div class="header-icon">🚀</div>
    <h1>Create Account</h1>
    <p>Join SkyReserve and start booking flights today</p>
  </div>

  <!-- Step indicator -->
  <div class="steps">
    <div class="step active">
      <div class="step-circle">1</div>
      <div class="step-label">Account</div>
    </div>
    <div class="step-line"></div>
    <div class="step">
      <div class="step-circle">2</div>
      <div class="step-label">Role</div>
    </div>
    <div class="step-line"></div>
    <div class="step">
      <div class="step-circle">✓</div>
      <div class="step-label">Done</div>
    </div>
  </div>

  <!-- Error banner -->
  <c:if test="${not empty error}">
    <div class="error-banner">
      <span>⚠️</span>
      <span>${error}</span>
    </div>
  </c:if>

  <form action="${pageContext.request.contextPath}/signup" method="post">

    <!-- Email -->
    <div class="form-group">
      <label for="email">Email Address</label>
      <div class="input-wrap">
        <span class="input-icon">✉️</span>
        <input type="email" id="email" name="email"
               placeholder="you@example.com" required/>
      </div>
    </div>

    <!-- Password -->
    <div class="form-group">
      <label for="password">Password</label>
      <div class="input-wrap">
        <span class="input-icon">🔒</span>
        <input type="password" id="password" name="password"
               placeholder="Create a strong password"
               oninput="checkStrength(this.value)"
               required/>
        <button type="button" class="toggle-pw"
                onclick="togglePw()" id="toggleBtn"
                title="Show / Hide password">👁️</button>
      </div>
      <!-- Strength meter -->
      <div class="strength-wrap">
        <div class="strength-bars">
          <div class="strength-bar" id="bar1"></div>
          <div class="strength-bar" id="bar2"></div>
          <div class="strength-bar" id="bar3"></div>
          <div class="strength-bar" id="bar4"></div>
        </div>
        <div class="strength-text" id="strengthText"></div>
      </div>
    </div>

    <!-- Role selector -->
    <span class="role-label">Select Your Role</span>
    <div class="role-grid">

      <label class="role-card">
        <input type="radio" name="role" value="USER" required/>
        <div class="role-tile">
          <div class="role-check">✓</div>
          <div class="role-icon">👤</div>
          <div class="role-name">Passenger</div>
          <div class="role-desc">Search &amp; book flights</div>
        </div>
      </label>

      <label class="role-card">
        <input type="radio" name="role" value="ADMIN"/>
        <div class="role-tile">
          <div class="role-check">✓</div>
          <div class="role-icon">🛩️</div>
          <div class="role-name">Admin</div>
          <div class="role-desc">Manage flights &amp; routes</div>
        </div>
      </label>

    </div>

    <!-- Submit -->
    <button type="submit" class="btn-submit">
      <span>🚀</span>
      <span>Create Account</span>
    </button>

  </form>

  <!-- Divider -->
  <div class="divider">
    <div class="divider-line"></div>
    <span class="divider-label">Already a member?</span>
    <div class="divider-line"></div>
  </div>

  <div class="login-row">
    Already have an account?&nbsp;
    <a href="${pageContext.request.contextPath}/login">Sign in →</a>
  </div>

  <div class="terms-note">
    By signing up you agree to our
    <a href="#">Terms of Service</a> &amp;
    <a href="#">Privacy Policy</a>
  </div>

</div>

<script>
  /* Code Generated by Sidekick is for learning and experimentation purposes only. */
  function togglePw() {
    const input = document.getElementById('password');
    const btn   = document.getElementById('toggleBtn');
    const show  = input.type === 'password';
    input.type      = show ? 'text' : 'password';
    btn.textContent = show ? '🙈' : '👁️';
  }

  function checkStrength(val) {
    const bars  = [1,2,3,4].map(i => document.getElementById('bar' + i));
    const label = document.getElementById('strengthText');
    const levels = [
      { re: /.{1,}/, color: null },
      { re: /.{6,}/, color: '#ef4444',  text: 'Weak',   textColor: '#fca5a5' },
      { re: /(?=.*[A-Z])(?=.*[0-9]).{7,}/, color: '#f59e0b', text: 'Fair',   textColor: '#fcd34d' },
      { re: /(?=.*[A-Z])(?=.*[0-9])(?=.*[^A-Za-z0-9]).{9,}/, color: '#22c55e', text: 'Strong', textColor: '#86efac' },
    ];

    let score = 0;
    if (val.length >= 6)  score = 1;
    if (val.length >= 8  && /[A-Z]/.test(val) && /[0-9]/.test(val)) score = 2;
    if (val.length >= 10 && /[A-Z]/.test(val) && /[0-9]/.test(val) && /[^A-Za-z0-9]/.test(val)) score = 3;

    const colours = ['#ef4444','#ef4444','#f59e0b','#22c55e'];
    const labels  = ['','Weak 🔴','Fair 🟡','Strong 🟢'];
    const lcolors = ['','#fca5a5','#fcd34d','#86efac'];

    bars.forEach((b, i) => {
      b.style.background = i <= score - 1 ? colours[score] : 'rgba(255,255,255,0.08)';
    });

    label.textContent  = val.length ? labels[score]  : '';
    label.style.color  = val.length ? lcolors[score] : 'transparent';
  }
</script>

</body>
</html>
