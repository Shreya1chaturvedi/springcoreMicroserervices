<%-- filename: search-flights.jsp --%>
<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Search Results — SkyReserve</title>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    /* Code Generated by Sidekick is for learning and experimentation purposes only. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg-deep:     #0a0a0f;
      --bg-card:     rgba(255,255,255,0.04);
      --border:      rgba(255,255,255,0.08);
      --accent:      #6c63ff;
      --accent-2:    #00d4ff;
      --accent-glow: rgba(108,99,255,0.35);
      --green:       #22c55e;
      --amber:       #f59e0b;
      --danger:      #ef4444;
      --text-1:      #f0f0f8;
      --text-2:      #9898b8;
      --text-3:      #55557a;
    }

    body {
      min-height: 100vh;
      font-family: 'Open Sans', sans-serif;
      background: var(--bg-deep);
      padding: 40px 20px 64px;
      overflow-x: hidden;
    }

    body::before, body::after {
      content: ''; position: fixed; border-radius: 50%;
      filter: blur(130px); z-index: 0; pointer-events: none;
    }
    body::before {
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(108,99,255,0.17) 0%, transparent 70%);
      top: -150px; left: -150px;
      animation: drift1 12s ease-in-out infinite alternate;
    }
    body::after {
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(0,212,255,0.11) 0%, transparent 70%);
      bottom: -100px; right: -100px;
      animation: drift2 15s ease-in-out infinite alternate;
    }
    @keyframes drift1 { from{transform:translate(0,0);} to{transform:translate(60px,40px);} }
    @keyframes drift2 { from{transform:translate(0,0);} to{transform:translate(-50px,-30px);} }

    .page { position: relative; z-index: 1; max-width: 900px; margin: 0 auto; }

    /* Hero */
    .page-hero {
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 16px; margin-bottom: 32px;
      animation: fadeUp 0.5s cubic-bezier(0.22,1,0.36,1) both;
    }
    .hero-left { display: flex; align-items: center; gap: 18px; }
    .hero-icon {
      display: flex; align-items: center; justify-content: center;
      width: 60px; height: 60px; border-radius: 20px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      font-size: 26px; box-shadow: 0 8px 32px var(--accent-glow); flex-shrink: 0;
    }
    .hero-text h1 { font-size: 26px; font-weight: 800; color: var(--text-1); letter-spacing: -0.5px; }
    .hero-text p  { font-size: 13px; color: var(--text-2); margin-top: 4px; }

    .back-btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 10px 20px; border-radius: 12px;
      background: rgba(255,255,255,0.04); border: 1px solid var(--border);
      color: var(--text-2); font-family: 'Open Sans',sans-serif;
      font-size: 13px; font-weight: 600; text-decoration: none;
      transition: background 0.18s, border-color 0.18s, color 0.18s, transform 0.18s;
    }
    .back-btn:hover {
      background: rgba(108,99,255,0.1); border-color: rgba(108,99,255,0.35);
      color: var(--text-1); transform: translateY(-1px);
    }

    /* ✅ Login notice banner */
    .login-notice {
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 12px;
      padding: 14px 22px;
      background: rgba(108,99,255,0.08);
      border: 1px solid rgba(108,99,255,0.25);
      border-radius: 14px;
      margin-bottom: 24px;
      animation: fadeUp 0.5s 0.06s cubic-bezier(0.22,1,0.36,1) both;
    }
    .notice-text { font-size: 13px; color: #c4c0ff; font-weight: 600; }
    .btn-login-notice {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 9px 20px; border-radius: 10px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      color: #fff; font-family: 'Open Sans',sans-serif;
      font-size: 12px; font-weight: 700; text-decoration: none;
      box-shadow: 0 4px 16px var(--accent-glow);
      transition: transform 0.15s, filter 0.15s;
    }
    .btn-login-notice:hover { transform: translateY(-1px); filter: brightness(1.1); }

    /* Route banner */
    .route-banner {
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 16px; padding: 20px 28px;
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: 20px; backdrop-filter: blur(16px);
      margin-bottom: 28px;
      animation: fadeUp 0.5s 0.08s cubic-bezier(0.22,1,0.36,1) both;
    }
    .route-display { display: flex; align-items: center; gap: 14px; }
    .route-city    { display: flex; flex-direction: column; align-items: center; gap: 3px; }
    .city-code     { font-size: 22px; font-weight: 800; color: var(--text-1); letter-spacing: 1px; }
    .city-label    { font-size: 11px; color: var(--text-2); letter-spacing: 0.5px; }
    .route-mid     { display: flex; flex-direction: column; align-items: center; gap: 4px; }
    .route-plane   { font-size: 20px; animation: fly 3s ease-in-out infinite; }
    .route-line    { width: 80px; height: 1px; background: linear-gradient(90deg, var(--accent), var(--accent-2)); opacity: 0.5; }
    @keyframes fly { 0%,100%{transform:translateX(0);} 50%{transform:translateX(6px);} }

    .result-meta { display: flex; gap: 12px; flex-wrap: wrap; }
    .meta-chip {
      display: flex; align-items: center; gap: 6px;
      padding: 7px 14px; border-radius: 999px;
      font-size: 12px; font-weight: 700;
    }
    .chip-purple { background:rgba(108,99,255,0.12); border:1px solid rgba(108,99,255,0.28); color:#c4c0ff; }
    .chip-green  { background:rgba(34,197,94,0.1);  border:1px solid rgba(34,197,94,0.25);  color:#86efac; }

    /* Filter bar */
    .filter-bar {
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
      margin-bottom: 24px;
      animation: fadeUp 0.5s 0.14s cubic-bezier(0.22,1,0.36,1) both;
    }
    .filter-label { font-size:11px; font-weight:700; color:var(--text-3); text-transform:uppercase; letter-spacing:0.8px; margin-right:4px; }
    .filter-btn {
      padding: 7px 16px; border-radius: 999px; border: 1px solid var(--border);
      background: rgba(255,255,255,0.03); color: var(--text-2);
      font-family: 'Open Sans',sans-serif; font-size: 12px; font-weight: 600;
      cursor: pointer; transition: background 0.18s, border-color 0.18s, color 0.18s;
    }
    .filter-btn:hover, .filter-btn.active {
      background: rgba(108,99,255,0.12); border-color: rgba(108,99,255,0.35); color: #c4c0ff;
    }

    /* Flight cards */
    .flights-list { display: flex; flex-direction: column; gap: 16px; }

    .flight-card {
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: 20px; overflow: hidden;
      backdrop-filter: blur(20px); box-shadow: 0 8px 32px rgba(0,0,0,0.3);
      transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
      animation: fadeUp 0.5s cubic-bezier(0.22,1,0.36,1) both;
    }
    .flight-card:hover {
      transform: translateY(-3px);
      border-color: rgba(108,99,255,0.28);
      box-shadow: 0 16px 48px rgba(0,0,0,0.4), 0 0 40px rgba(108,99,255,0.1);
    }
    .flight-card::before {
      content: ''; display: block; height: 2px;
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      opacity: 0; transition: opacity 0.2s;
    }
    .flight-card:hover::before { opacity: 1; }

    .card-body {
      display: grid;
      grid-template-columns: 1fr auto 1fr auto auto;
      align-items: center; gap: 24px; padding: 24px 28px;
    }

    .flight-id    { display: flex; flex-direction: column; gap: 4px; }
    .flight-badge { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 800; color: #c4c0ff; }
    .flight-dot   { width:8px; height:8px; border-radius:50%; background:var(--accent); box-shadow:0 0 8px var(--accent); flex-shrink:0; }
    .airline-name { font-size:11px; color:var(--text-3); font-weight:600; letter-spacing:0.4px; }

    .time-block  { display: flex; flex-direction: column; gap: 3px; }
    .time-main   { font-size:22px; font-weight:800; color:var(--text-1); letter-spacing:-0.5px; line-height:1; }
    .time-city   { font-size:12px; color:var(--text-2); font-weight:600; }
    .time-label  { font-size:10px; color:var(--text-3); text-transform:uppercase; letter-spacing:0.7px; }

    .route-mid-col {
      display: flex; flex-direction: column; align-items: center;
      gap: 5px; min-width: 100px;
    }
    .route-dots      { display:flex; align-items:center; gap:3px; }
    .rdot            { width:4px; height:4px; border-radius:50%; background:var(--text-3); }
    .route-plane-sm  { font-size:16px; animation:fly 3s ease-in-out infinite; }
    .route-type      { font-size:10px; color:var(--text-3); text-transform:uppercase; letter-spacing:0.7px; }

    .price-col {
      display: flex; flex-direction: column; align-items: flex-end; gap: 4px;
    }
    .price-amount {
      font-size:22px; font-weight:800;
      background:linear-gradient(135deg,var(--accent),var(--accent-2));
      -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
      letter-spacing:-0.5px; line-height:1;
    }
    .price-label-sm { font-size:10px; color:var(--text-3); text-transform:uppercase; letter-spacing:0.7px; }

    .action-col { display:flex; flex-direction:column; align-items:flex-end; gap:10px; }

    /* ✅ Book Now button */
    .btn-book {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 12px 22px; border-radius: 12px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      border: none; color: #fff; font-family: 'Open Sans',sans-serif;
      font-size: 13px; font-weight: 700; text-decoration: none; white-space: nowrap;
      box-shadow: 0 6px 20px var(--accent-glow);
      transition: transform 0.15s, filter 0.15s, box-shadow 0.15s;
    }
    .btn-book:hover {
      transform: translateY(-2px) scale(1.03);
      filter: brightness(1.1); box-shadow: 0 10px 28px var(--accent-glow);
    }
    .btn-book:active { transform: scale(0.98); }

    /* ✅ Login to Book button — shown when NOT logged in */
    .btn-login-book {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 11px 18px; border-radius: 12px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(108,99,255,0.35);
      color: #a89fff; font-family: 'Open Sans',sans-serif;
      font-size: 13px; font-weight: 700; text-decoration: none; white-space: nowrap;
      transition: background 0.18s, color 0.18s, transform 0.15s;
    }
    .btn-login-book:hover {
      background: rgba(108,99,255,0.12); color: var(--text-1);
      transform: translateY(-2px);
    }

    /* Card footer */
    .card-footer {
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 10px; padding: 12px 28px;
      background: rgba(255,255,255,0.02); border-top: 1px solid var(--border);
    }
    .footer-tags { display: flex; gap: 8px; flex-wrap: wrap; }
    .tag { display:inline-flex; align-items:center; gap:5px; padding:4px 10px; border-radius:999px; font-size:11px; font-weight:700; }
    .tag-refund { background:rgba(34,197,94,0.08);  border:1px solid rgba(34,197,94,0.22);  color:#86efac; }
    .tag-meal   { background:rgba(0,212,255,0.08);  border:1px solid rgba(0,212,255,0.22);  color:#67e8f9; }

    .seat-badge { display:inline-flex; align-items:center; gap:5px; padding:4px 12px; border-radius:999px; font-size:12px; font-weight:700; }
    .seat-high { background:rgba(34,197,94,0.12);  border:1px solid rgba(34,197,94,0.28);  color:#86efac; }
    .seat-mid  { background:rgba(245,158,11,0.1);  border:1px solid rgba(245,158,11,0.28); color:#fcd34d; }
    .seat-low  { background:rgba(239,68,68,0.1);   border:1px solid rgba(239,68,68,0.28);  color:#fca5a5; }

    /* Empty state */
    .empty-wrap {
      display: flex; flex-direction: column; align-items: center;
      justify-content: center; padding: 80px 20px; text-align: center;
      animation: fadeUp 0.5s 0.1s cubic-bezier(0.22,1,0.36,1) both;
    }
    .empty-icon  { font-size:64px; margin-bottom:20px; }
    .empty-wrap h3 { font-size:22px; font-weight:800; color:var(--text-1); }
    .empty-wrap p  { font-size:14px; color:var(--text-2); margin-top:10px; line-height:1.7; }
    .btn-try-again {
      display:inline-flex; align-items:center; gap:8px;
      margin-top:28px; padding:14px 28px; border-radius:14px;
      background:linear-gradient(135deg,var(--accent),var(--accent-2));
      color:#fff; font-family:'Open Sans',sans-serif;
      font-size:14px; font-weight:700; text-decoration:none;
      box-shadow:0 8px 28px var(--accent-glow);
      transition:transform 0.18s, filter 0.18s;
    }
    .btn-try-again:hover { transform:translateY(-2px); filter:brightness(1.1); }

    .page-footer {
      text-align:center; margin-top:56px; font-size:11px;
      color:var(--text-3); letter-spacing:0.3px;
      animation: fadeUp 0.5s 0.4s cubic-bezier(0.22,1,0.36,1) both;
    }

    @keyframes fadeUp { from{opacity:0;transform:translateY(24px);} to{opacity:1;transform:translateY(0);} }

    @media(max-width:700px) {
      .card-body { grid-template-columns: 1fr 1fr; gap: 16px; }
      .route-mid-col { display: none; }
      .price-col, .action-col { align-items: flex-start; }
      .btn-book, .btn-login-book { width: 100%; justify-content: center; }
    }
    @media(max-width:480px) {
      .card-body { grid-template-columns: 1fr; }
      .page-hero, .route-banner { flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>
<body>
<div class="page">

  <!-- Page hero -->
  <div class="page-hero">
    <div class="hero-left">
      <div class="hero-icon">🔍</div>
      <div class="hero-text">
        <h1>Available Flights</h1>
        <p>Pick the best flight for your journey</p>
      </div>
    </div>
    <a href="${pageContext.request.contextPath}/" class="back-btn">← New Search</a>
  </div>

  <%-- ✅ KEY FIX: Show login notice banner when user is NOT logged in --%>
  <c:if test="${empty sessionScope.user}">
    <div class="login-notice">
      <span class="notice-text">
        🔐 &nbsp;You must be logged in to book a flight
      </span>
      <a href="${pageContext.request.contextPath}/login"
         class="btn-login-notice">
        Login to Book →
      </a>
    </div>
  </c:if>

  <c:choose>
    <c:when test="${empty flights}">
      <div class="empty-wrap">
        <div class="empty-icon">🛫</div>
        <h3>No Flights Found</h3>
        <p>We couldn't find any flights matching your search.<br/>
           Try different cities or dates.</p>
        <a href="${pageContext.request.contextPath}/" class="btn-try-again">
          🔍 &nbsp;Try Again
        </a>
      </div>
    </c:when>
    <c:otherwise>

      <!-- Route banner -->
      <div class="route-banner">
        <div class="route-display">
          <div class="route-city">
            <span class="city-code">✈️</span>
            <span class="city-label">Origin</span>
          </div>
          <div class="route-mid">
            <div class="route-plane">✈️</div>
            <div class="route-line"></div>
          </div>
          <div class="route-city">
            <span class="city-code">🛬</span>
            <span class="city-label">Destination</span>
          </div>
        </div>
        <div class="result-meta">
          <span class="meta-chip chip-purple">
            ✈️ &nbsp;${flights.size()} Flight<c:if test="${flights.size() != 1}">s</c:if> Found
          </span>
          <span class="meta-chip chip-green">✅ &nbsp;Instant Booking</span>
        </div>
      </div>

      <!-- Filter bar -->
      <div class="filter-bar">
        <span class="filter-label">Sort by:</span>
        <button class="filter-btn active">💰 Lowest Price</button>
        <button class="filter-btn">⏱️ Departure Time</button>
        <button class="filter-btn">💺 Most Seats</button>
      </div>

      <!-- Flight cards -->
      <div class="flights-list">
        <c:forEach var="flight" items="${flights}" varStatus="loop">
          <div class="flight-card" style="animation-delay:${loop.index * 0.07}s">

            <div class="card-body">

              <div class="flight-id">
                <span class="flight-badge">
                  <span class="flight-dot"></span>${flight.flightNumber}
                </span>
                <span class="airline-name">SkyReserve Air</span>
              </div>

              <div class="time-block">
                <div class="time-label">Departure</div>
                <div class="time-main">${flight.departureTime}</div>
                <div class="time-city">🛫 ${flight.source}</div>
              </div>

              <div class="route-mid-col">
                <span class="route-plane-sm">✈️</span>
                <div class="route-dots">
                  <span class="rdot"></span><span class="rdot"></span>
                  <span class="rdot"></span><span class="rdot"></span>
                  <span class="rdot"></span>
                </div>
                <span class="route-type">Non-stop</span>
              </div>

              <div class="time-block">
                <div class="time-label">Arrival</div>
                <div class="time-main">${flight.arrivalTime}</div>
                <div class="time-city">🛬 ${flight.destination}</div>
              </div>

              <div class="price-col">
                <div class="price-label-sm">Per Seat</div>
                <div class="price-amount">&#8377;${flight.pricePerSeat}</div>
              </div>

              <%-- ✅ CORE FIX: Show Book Now OR Login to Book based on session --%>
              <div class="action-col">
                <c:choose>
                  <c:when test="${not empty sessionScope.user}">
                    <%-- Logged in → Book Now --%>
                    <a href="${pageContext.request.contextPath}/booking?flightId=${flight.flightId}"
                       class="btn-book">
                      🎫 &nbsp;Book Now
                    </a>
                  </c:when>
                  <c:otherwise>
                    <%-- NOT logged in → Login to Book --%>
                    <a href="${pageContext.request.contextPath}/login"
                       class="btn-login-book">
                      🔐 &nbsp;Login to Book
                    </a>
                  </c:otherwise>
                </c:choose>
              </div>

            </div>

            <!-- Card footer -->
            <div class="card-footer">
              <div class="footer-tags">
                <span class="tag tag-refund">✅ Refundable</span>
                <span class="tag tag-meal">🍽️ Meal Included</span>
              </div>
              <c:choose>
                <c:when test="${flight.availableSeats > 10}">
                  <span class="seat-badge seat-high">💺 ${flight.availableSeats} seats available</span>
                </c:when>
                <c:when test="${flight.availableSeats > 3}">
                  <span class="seat-badge seat-mid">💺 ${flight.availableSeats} seats left</span>
                </c:when>
                <c:otherwise>
                  <span class="seat-badge seat-low">🔥 Only ${flight.availableSeats} left!</span>
                </c:otherwise>
              </c:choose>
            </div>

          </div>
        </c:forEach>
      </div>

    </c:otherwise>
  </c:choose>

  <div class="page-footer">
    SkyReserve &nbsp;•&nbsp; Best Fares Guaranteed ✈️ &nbsp;•&nbsp; Safe Travels 🛡️
  </div>
</div>

<script>
  /* Code Generated by Sidekick is for learning and experimentation purposes only. */
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
    });
  });
</script>
</body>
</html>
