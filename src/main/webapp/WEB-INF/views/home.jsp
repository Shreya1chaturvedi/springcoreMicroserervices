<%-- filename: index.jsp --%>
<%@ page contentType="text/html;charset=UTF-8" %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Flight Reservation System</title>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    /* Code Generated by Sidekick is for learning and experimentation purposes only. */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg-deep:     #0a0a0f;
      --bg-card:     rgba(255,255,255,0.04);
      --border:      rgba(255,255,255,0.08);
      --accent:      #6c63ff;
      --accent-2:    #00d4ff;
      --accent-glow: rgba(108,99,255,0.35);
      --text-1:      #f0f0f8;
      --text-2:      #9898b8;
      --input-bg:    rgba(255,255,255,0.05);
      --input-focus: rgba(108,99,255,0.15);
    }

    body {
      min-height: 100vh;
      font-family: 'Open Sans', sans-serif;
      background: var(--bg-deep);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 32px 16px;
      overflow-x: hidden;
    }

    /* Background orbs */
    body::before, body::after {
      content: '';
      position: fixed;
      border-radius: 50%;
      filter: blur(130px);
      z-index: 0;
      pointer-events: none;
    }
    body::before {
      width: 650px; height: 650px;
      background: radial-gradient(circle, rgba(108,99,255,0.18) 0%, transparent 70%);
      top: -180px; left: -180px;
      animation: drift1 12s ease-in-out infinite alternate;
    }
    body::after {
      width: 550px; height: 550px;
      background: radial-gradient(circle, rgba(0,212,255,0.13) 0%, transparent 70%);
      bottom: -120px; right: -120px;
      animation: drift2 15s ease-in-out infinite alternate;
    }
    @keyframes drift1 { from { transform: translate(0,0); } to { transform: translate(60px,40px); } }
    @keyframes drift2 { from { transform: translate(0,0); } to { transform: translate(-50px,-30px); } }

    /* Third ambient orb */
    .orb3 {
      position: fixed;
      width: 400px; height: 400px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(0,212,255,0.07) 0%, transparent 70%);
      filter: blur(100px);
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
      z-index: 0;
      animation: pulse 8s ease-in-out infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 0.5; transform: translate(-50%,-50%) scale(1); }
      50%       { opacity: 1;   transform: translate(-50%,-50%) scale(1.15); }
    }

    /* Hero text */
    .hero {
      position: relative;
      z-index: 1;
      text-align: center;
      margin-bottom: 40px;
      animation: fadeUp 0.6s cubic-bezier(0.22,1,0.36,1) both;
    }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 16px;
      border-radius: 999px;
      background: rgba(108,99,255,0.12);
      border: 1px solid rgba(108,99,255,0.28);
      font-size: 11px;
      font-weight: 700;
      color: #a89fff;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      margin-bottom: 20px;
    }
    .hero h1 {
      font-size: clamp(32px, 6vw, 52px);
      font-weight: 800;
      color: var(--text-1);
      line-height: 1.15;
      letter-spacing: -1px;
    }
    .hero h1 span {
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .hero p {
      margin-top: 14px;
      font-size: 15px;
      color: var(--text-2);
      font-weight: 400;
      max-width: 380px;
      margin-inline: auto;
      line-height: 1.7;
    }

    /* Stats row */
    .stats {
      position: relative;
      z-index: 1;
      display: flex;
      gap: 24px;
      justify-content: center;
      margin-bottom: 40px;
      animation: fadeUp 0.6s 0.1s cubic-bezier(0.22,1,0.36,1) both;
    }
    .stat {
      text-align: center;
    }
    .stat-num {
      font-size: 20px;
      font-weight: 800;
      color: var(--text-1);
    }
    .stat-label {
      font-size: 11px;
      color: var(--text-2);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-top: 2px;
    }
    .stat-divider {
      width: 1px;
      background: var(--border);
      align-self: stretch;
    }

    /* Search card */
    .card {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 540px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 40px 36px;
      backdrop-filter: blur(24px);
      box-shadow:
        0 0 0 1px rgba(255,255,255,0.04),
        0 32px 64px rgba(0,0,0,0.5),
        0 0 80px var(--accent-glow);
      animation: fadeUp 0.6s 0.15s cubic-bezier(0.22,1,0.36,1) both;
    }

    .card-label {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 24px;
    }
    .card-label-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 38px; height: 38px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      font-size: 17px;
      box-shadow: 0 4px 16px var(--accent-glow);
    }
    .card-label-text h2 {
      font-size: 16px;
      font-weight: 700;
      color: var(--text-1);
    }
    .card-label-text p {
      font-size: 12px;
      color: var(--text-2);
      margin-top: 1px;
    }

    /* Input row */
    .input-row {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: end;
      gap: 12px;
      margin-bottom: 20px;
    }
    .form-group { display: flex; flex-direction: column; gap: 8px; }
    label {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-2);
      letter-spacing: 0.8px;
      text-transform: uppercase;
    }
    .input-wrap { position: relative; display: flex; align-items: center; }
    .input-icon {
      position: absolute;
      left: 13px;
      font-size: 15px;
      pointer-events: none;
      color: var(--text-2);
      transition: color 0.2s;
    }
    input[type="text"] {
      width: 100%;
      padding: 13px 13px 13px 40px;
      background: var(--input-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      color: var(--text-1);
      font-family: 'Open Sans', sans-serif;
      font-size: 14px;
      font-weight: 600;
      outline: none;
      transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
    }
    input[type="text"]::placeholder { color: #55557a; font-weight: 400; }
    input[type="text"]:focus {
      border-color: var(--accent);
      background: var(--input-focus);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }
    .input-wrap:focus-within .input-icon { color: var(--accent); }

    /* Swap button */
    .swap-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px; height: 40px;
      border-radius: 50%;
      background: rgba(108,99,255,0.12);
      border: 1px solid rgba(108,99,255,0.25);
      color: #a89fff;
      font-size: 16px;
      cursor: pointer;
      margin-bottom: 1px;
      transition: background 0.18s, transform 0.3s, box-shadow 0.18s;
      flex-shrink: 0;
    }
    .swap-btn:hover {
      background: rgba(108,99,255,0.22);
      box-shadow: 0 0 16px var(--accent-glow);
      transform: rotate(180deg);
    }

    /* Search button */
    .btn-search {
      width: 100%;
      padding: 15px;
      background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 100%);
      border: none;
      border-radius: 14px;
      color: #fff;
      font-family: 'Open Sans', sans-serif;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.3px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow: 0 8px 32px var(--accent-glow);
      transition: transform 0.15s, box-shadow 0.15s, filter 0.15s;
    }
    .btn-search:hover {
      transform: translateY(-2px);
      filter: brightness(1.1);
      box-shadow: 0 14px 40px var(--accent-glow);
    }
    .btn-search:active { transform: translateY(0); }

    /* Divider */
    .divider {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 28px 0 22px;
    }
    .divider-line { flex: 1; height: 1px; background: var(--border); }
    .divider-label { font-size: 11px; color: var(--text-2); letter-spacing: 1px; text-transform: uppercase; white-space: nowrap; }

    /* Auth links */
    .auth-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .auth-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 13px;
      border-radius: 13px;
      text-decoration: none;
      font-size: 13px;
      font-weight: 700;
      transition: transform 0.18s, box-shadow 0.18s, background 0.18s, border-color 0.18s;
    }
    .auth-btn:hover { transform: translateY(-2px); }

    .btn-login {
      background: rgba(108,99,255,0.1);
      border: 1px solid rgba(108,99,255,0.3);
      color: #c4c0ff;
    }
    .btn-login:hover {
      background: rgba(108,99,255,0.18);
      border-color: rgba(108,99,255,0.55);
      box-shadow: 0 6px 24px var(--accent-glow);
    }
    .btn-signup {
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      border: none;
      color: #fff;
      box-shadow: 0 4px 20px var(--accent-glow);
    }
    .btn-signup:hover {
      filter: brightness(1.12);
      box-shadow: 0 8px 28px var(--accent-glow);
    }

    /* Footer */
    .footer {
      position: relative;
      z-index: 1;
      margin-top: 28px;
      font-size: 11px;
      color: #55557a;
      letter-spacing: 0.3px;
      text-align: center;
      animation: fadeUp 0.6s 0.3s cubic-bezier(0.22,1,0.36,1) both;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(30px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 480px) {
      .card { padding: 28px 18px; }
      .input-row { grid-template-columns: 1fr; }
      .swap-btn { display: none; }
      .stats { gap: 16px; }
    }
  </style>
</head>
<body>

<div class="orb3"></div>

<!-- Hero -->
<div class="hero">
  <div class="hero-badge">✈️ &nbsp;Live Booking Platform</div>
  <h1>Your Journey Starts<br/><span>Here</span></h1>
  <p>Search hundreds of flights and find the best deals for your next adventure.</p>
</div>

<!-- Stats -->
<div class="stats">
  <div class="stat">
    <div class="stat-num">500+</div>
    <div class="stat-label">Routes</div>
  </div>
  <div class="stat-divider"></div>
  <div class="stat">
    <div class="stat-num">24/7</div>
    <div class="stat-label">Support</div>
  </div>
  <div class="stat-divider"></div>
  <div class="stat">
    <div class="stat-num">98%</div>
    <div class="stat-label">On-Time</div>
  </div>
</div>

<!-- Search card -->
<div class="card">

  <div class="card-label">
    <div class="card-label-icon">🔍</div>
    <div class="card-label-text">
      <h2>Search Flights</h2>
      <p>Enter your origin and destination</p>
    </div>
  </div>

  <form action="${pageContext.request.contextPath}/search" method="post" id="searchForm">
    <div class="input-row">

      <div class="form-group">
        <label for="source">From</label>
        <div class="input-wrap">
          <span class="input-icon">🛫</span>
          <input type="text" id="source" name="source"
                 placeholder="e.g. New York" required/>
        </div>
      </div>

      <button type="button" class="swap-btn" onclick="swapFields()" title="Swap">⇄</button>

      <div class="form-group">
        <label for="destination">To</label>
        <div class="input-wrap">
          <span class="input-icon">🛬</span>
          <input type="text" id="destination" name="destination"
                 placeholder="e.g. London" required/>
        </div>
      </div>

    </div>

    <button type="submit" class="btn-search">
      <span>✈️</span>
      <span>Search Flights</span>
    </button>
  </form>

  <!-- Auth section -->
  <div class="divider">
    <div class="divider-line"></div>
    <span class="divider-label">Your Account</span>
    <div class="divider-line"></div>
  </div>

  <div class="auth-row">
    <a href="${pageContext.request.contextPath}/login" class="auth-btn btn-login">
      🔑 &nbsp;Login
    </a>
    <a href="${pageContext.request.contextPath}/signup" class="auth-btn btn-signup">
      🚀 &nbsp;Sign Up
    </a>
  </div>

</div>

<div class="footer">SkyReserve &nbsp;•&nbsp; Powered by ✨ &nbsp;•&nbsp; All rights reserved</div>

<script>
  /* Code Generated by Sidekick is for learning and experimentation purposes only. */
  function swapFields() {
    const src  = document.getElementById('source');
    const dest = document.getElementById('destination');
    [src.value, dest.value] = [dest.value, src.value];
  }
</script>

</body>
</html>
